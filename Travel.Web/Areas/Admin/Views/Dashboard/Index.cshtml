
@{
    ViewData["Title"] = "Admin Paneli";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .eyebrow {
        font-family: 'Sora', sans-serif;
        text-transform: uppercase;
        letter-spacing: .2em;
        font-size: .7rem;
        font-weight: 700;
        color: var(--teal-dark);
    }

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .3rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
            max-width: 60ch;
        }

    .date-pill {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .5rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        color: var(--navy);
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
    }

        .date-pill svg {
            color: var(--teal-dark);
        }

    .card-x {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 1.3rem .2rem;
    }

        .card-head h3 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--navy);
            margin: 0;
        }

    .card-body {
        padding: 1.3rem;
    }

    /* KPI */

    .kpi {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        padding: 1.25rem 1.3rem;
        height: 100%;
    }

        .kpi .top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: .9rem;
        }

        .kpi .ic {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
        }

            .kpi .ic.warn {
                background: rgba(169,116,26,.12);
                color: #a9741a;
            }

        .kpi .trend {
            font-size: .74rem;
            font-weight: 600;
            padding: .2rem .5rem;
            border-radius: 999px;
            background: var(--ok-bg);
            color: var(--ok-fg);
        }

        .kpi .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.9rem;
            color: var(--navy);
            line-height: 1;
        }

        .kpi .lab {
            font-size: .85rem;
            color: var(--muted);
            margin-top: .25rem;
        }

        .kpi .sub {
            font-size: .78rem;
            color: var(--muted);
            margin-top: .55rem;
            display: flex;
            align-items: center;
            gap: .35rem;
        }

            .kpi .sub .up {
                color: var(--teal-dark);
                font-weight: 600;
            }

            .kpi .sub.warn {
                color: #a9741a;
                font-weight: 600;
            }

    /* CHART */

    .chart-select {
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 999px;
        padding: .4rem 1.9rem .4rem .9rem;
        font-size: .82rem;
        font-weight: 600;
        color: var(--navy);
        cursor: pointer;
        outline: none;
    }

    .chart-wrap {
        position: relative;
        height: 280px;
    }

    /* POPULAR TOURS */

    .pt-item {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .7rem 0;
        border-top: 1px solid var(--line-2);
    }

        .pt-item:first-child {
            padding-top: .2rem;
            border-top: none;
        }

        .pt-item img {
            width: 48px;
            height: 48px;
            border-radius: 11px;
            object-fit: cover;
            flex: none;
        }

        .pt-item .nm {
            flex: 1;
            min-width: 0;
        }

            .pt-item .nm b {
                font-family: 'Sora';
                font-weight: 600;
                font-size: .9rem;
                color: var(--navy);
                display: block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .pt-item .nm span {
                font-size: .78rem;
                color: var(--muted);
            }

        .pt-item .rank {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--line);
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
            flex: none;
        }

    /* TABLE */

    .tbl-wrap {
        overflow-x: auto;
    }

    table.tx {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 760px;
    }

        table.tx th {
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--muted);
            font-weight: 600;
            text-align: left;
            padding: .7rem 1rem;
            border-bottom: 1px solid var(--line);
        }

        table.tx td {
            padding: .85rem 1rem;
            border-bottom: 1px solid var(--line-2);
            font-size: .88rem;
            color: var(--navy);
            vertical-align: middle;
        }

        table.tx tr:last-child td {
            border-bottom: none;
        }

        table.tx tbody tr {
            transition: .15s;
        }

            table.tx tbody tr:hover {
                background: var(--cream);
            }

    .res-no {
        font-family: 'Sora';
        font-weight: 600;
        color: var(--navy);
    }

    .guest {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .guest .av {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: var(--navy-2);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: .72rem;
            font-weight: 700;
            font-family: 'Sora';
            flex: none;
        }

    .amount {
        font-family: 'Sora';
        font-weight: 600;
    }

    .badge-x {
        font-size: .74rem;
        font-weight: 600;
        padding: .28rem .7rem;
        border-radius: 999px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .badge-x::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .b-ok {
        background: var(--ok-bg);
        color: var(--ok-fg);
    }

    .b-wait {
        background: var(--wait-bg);
        color: var(--wait-fg);
    }

    .b-cancel {
        background: var(--cancel-bg);
        color: var(--cancel-fg);
    }

    .btn-soft {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .4rem .9rem;
        font-size: .8rem;
        font-weight: 600;
        color: var(--navy);
        cursor: pointer;
        transition: .2s;
    }

        .btn-soft:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    /* REVIEWS */

    .rv {
        padding: .85rem 0;
        border-top: 1px solid var(--line-2);
    }

        .rv:first-child {
            border-top: none;
            padding-top: .1rem;
        }

        .rv .h {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: .35rem;
        }

        .rv .av {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--navy-2);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: .72rem;
            font-weight: 700;
            font-family: 'Sora';
            flex: none;
        }

        .rv .h b {
            font-family: 'Sora';
            font-size: .86rem;
            color: var(--navy);
            display: block;
            line-height: 1.2;
        }

        .rv .h span {
            font-size: .74rem;
            color: var(--muted);
        }

        .rv .stars {
            margin-left: auto;
            color: #f4a92c;
            font-size: .8rem;
        }

            .rv .stars .off {
                color: #d8cfc0;
            }

        .rv p {
            margin: 0;
            font-size: .85rem;
            color: var(--muted);
            line-height: 1.5;
        }

    /* QUESTIONS */

    .qz {
        padding: .85rem 0;
        border-top: 1px solid var(--line-2);
        display: flex;
        gap: .8rem;
        align-items: flex-start;
    }

        .qz:first-child {
            border-top: none;
            padding-top: .1rem;
        }

        .qz .body {
            flex: 1;
            min-width: 0;
        }

        .qz .tour {
            font-size: .74rem;
            color: var(--teal-dark);
            font-weight: 600;
        }

        .qz .q {
            font-size: .87rem;
            color: var(--navy);
            font-weight: 500;
            margin: .15rem 0 .2rem;
        }

        .qz .time {
            font-size: .74rem;
            color: var(--muted);
        }

        .qz .btn-soft {
            flex: none;
            align-self: center;
        }

    /* QUICK ACTIONS */

    .qa-link {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .75rem .85rem;
        border-radius: 12px;
        border: 1px solid var(--line-2);
        color: var(--navy);
        font-weight: 600;
        font-size: .88rem;
        transition: .2s;
        margin-bottom: .6rem;
        background: #fff;
    }

        .qa-link:last-child {
            margin-bottom: 0;
        }

        .qa-link:hover {
            border-color: var(--teal);
            background: var(--cream);
            color: var(--teal-dark);
        }

        .qa-link .qa-ic {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            flex: none;
            transition: .2s;
        }

        .qa-link:hover .qa-ic {
            background: var(--teal);
            color: #fff;
        }

        .qa-link .arr {
            margin-left: auto;
            color: var(--muted);
        }
</style>

<div class="content">

    <div class="page-intro">

        <div>
            <div class="eyebrow">Genel Bakış</div>

            <h1>Hoş Geldiniz, Elif 👋</h1>

            <p>
                Travelio platformundaki son gelişmeleri ve önemli verileri
                buradan takip edebilirsiniz.
            </p>
        </div>

        <div class="date-pill">

            <svg width="15" height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <rect x="3" y="4" width="18" height="18" rx="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />

            </svg>

            

        </div>

    </div>

    <!-- KPIs -->
	@await Component.InvokeAsync("StatisticsCards")
   

    <!-- CHART + POPULAR TOURS -->
    @await Component.InvokeAsync("PopularTours")
   

    <!-- RECENT BOOKINGS -->
    @await Component.InvokeAsync("RecentBookings")
    

    <!-- BOTTOM 3 COLS -->

    <div class="row g-3">

        @await Component.InvokeAsync("RecentComments")
        @await Component.InvokeAsync("UnAnsweredQuestions")
        @await Component.InvokeAsync("QuickActions")
       

       
    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>

        const IMG = {
            roma: "https://images.unsplash.com/photo-1552832230-c0197dd311b5?auto=format&fit=crop&w=200&q=80",
            paris: "https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=200&q=80",
            barcelona: "https://images.unsplash.com/photo-1583422409516-2895a77efded?auto=format&fit=crop&w=200&q=80",
            prag: "https://images.unsplash.com/photo-1541849546-216549ae216d?auto=format&fit=crop&w=200&q=80",
            swiss: "https://images.unsplash.com/photo-1531366936337-7c912a4589a7?auto=format&fit=crop&w=200&q=80"
        };

           

        

        const initials = n =>
            n.split(" ")
                .map(w => w[0])
                .slice(0, 2)
                .join("")
                .toUpperCase();

      

        const reviews = [
            {
                name: "Elif Yılmaz",
                tour: "Roma & Toskana",
                stars: 5,
                text: "Tur organizasyonu gerçekten çok başarılıydı, her detay düşünülmüştü."
            },
            {
                name: "Mert Kaya",
                tour: "Amsterdam Kanalları",
                stars: 4,
                text: "Rehber ve program oldukça iyiydi, keyifli bir seyahatti."
            },
            {
                name: "Zeynep Demir",
                tour: "İsviçre Alpleri",
                stars: 5,
                text: "Muhteşem bir deneyimdi, manzaralar beklentimin ötesindeydi."
            }
        ];

        const starStr = n => {
            let s = "";

            for (let i = 1; i <= 5; i++) {
                s += i <= n
                    ? "★"
                    : "<span class='off'>★</span>";
            }

            return s;
        };

        document.getElementById("recentReviews").innerHTML =
            reviews.map(r => `
                <div class="rv">

                    <div class="h">

                        <span class="av">
                            ${initials(r.name)}
                        </span>

                        <div>
                            <b>${r.name}</b>
                            <span>${r.tour}</span>
                        </div>

                        <span class="stars">
                            ${starStr(r.stars)}
                        </span>

                    </div>

                    <p>${r.text}</p>

                </div>
            `).join("");


        const questions = [
            {
                tour: "Kuzey Işıkları Norveç",
                q: "Termal kıyafet sağlanıyor mu?",
                time: "2 saat önce"
            },
            {
                tour: "Tokyo & Kyoto",
                q: "Japonya vizesi konusunda destek veriliyor mu?",
                time: "5 saat önce"
            },
            {
                tour: "Roma & Toskana",
                q: "Havalimanı transferi fiyata dahil mi?",
                time: "1 gün önce"
            }
        ];

        document.getElementById("pendingQuestions").innerHTML =
            questions.map(q => `
                <div class="qz">

                    <div class="body">

                        <div class="tour">
                            ${q.tour}
                        </div>

                        <div class="q">
                            ${q.q}
                        </div>

                        <div class="time">
                            ${q.time}
                        </div>

                    </div>

                    <button class="btn-soft">
                        Cevapla
                    </button>

                </div>
            `).join("");


        const actions = [
            {
                t: "Yeni Tur Ekle",
                ic: '<path d="M12 5v14M5 12h14"/>'
            },
            {
                t: "Rezervasyonları Gör",
                ic: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>'
            },
            {
                t: "Soruları Yanıtla",
                ic: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>'
            },
            {
                t: "Yeni Destinasyon Ekle",
                ic: '<path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>'
            }
        ];

        document.getElementById("quickActions").innerHTML =
            actions.map(a => `
                <a href="#" class="qa-link">

                    <span class="qa-ic">
                        <svg width="17" height="17"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            ${a.ic}
                        </svg>
                    </span>

                    ${a.t}

                    <span class="arr">
                        <svg width="16" height="16"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </span>

                </a>
            `).join("");


                const ctx = document.getElementById("resChart");

        const chartDataElement =
            document.getElementById("reservationChartData");

        const reservationStats =
            JSON.parse(chartDataElement.textContent);

        const labels = reservationStats.map(x => x.Month);
        const counts = reservationStats.map(x => x.ReservationCount);

        const grad = ctx.getContext("2d")
            .createLinearGradient(0, 0, 0, 280);

        grad.addColorStop(0, "rgba(15,163,163,.28)");
        grad.addColorStop(1, "rgba(15,163,163,0)");

        new Chart(ctx, {
            type: "line",

            data: {
                labels: labels,

                datasets: [{
                    label: "Rezervasyon",
                    data: counts,

                    borderColor: "#0fa3a3",
                    backgroundColor: grad,
                    borderWidth: 3,
                    fill: true,
                    tension: .38,

                    pointBackgroundColor: "#fff",
                    pointBorderColor: "#0fa3a3",
                    pointBorderWidth: 2.5,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    },

                    tooltip: {
                        backgroundColor: "#0e2a3b",
                        padding: 12,
                        cornerRadius: 10,
                        displayColors: false,

                        callbacks: {
                            label: function (context) {
                                return context.parsed.y + " rezervasyon";
                            }
                        }
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0,
                            color: "#6a7c88"
                        },
                        grid: {
                            color: "#eef0ef"
                        },
                        border: {
                            display: false
                        }
                    },

                    x: {
                        grid: {
                            display: false
                        },
                        border: {
                            display: false
                        },
                        ticks: {
                            color: "#6a7c88"
                        }
                    }
                }
            }
        });

        document
            .getElementById("rangeSelect")
            .addEventListener("change", () => chart.update());

    </script>
}

