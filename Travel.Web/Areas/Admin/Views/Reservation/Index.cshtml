

@using Travel.Web.DTOs.ReservationDtos
@using Travel.Web.Entities.Enums

@model List<ResultReservationDto>

@{
    ViewData["Title"] = "Rezervasyonlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .15rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
            max-width: 60ch;
        }

    /* KPI */

    .kpi {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        padding: 1rem 1.1rem;
        height: 100%;
        display: flex;
        align-items: center;
        gap: .85rem;
    }

        .kpi .ic {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            flex: none;
        }

            .kpi .ic.gray {
                background: rgba(106,124,136,.12);
                color: var(--muted);
            }

            .kpi .ic.warn {
                background: rgba(169,116,26,.12);
                color: #a9741a;
            }

        .kpi .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--navy);
            line-height: 1;
        }

        .kpi .lab {
            font-size: .82rem;
            color: var(--muted);
            margin-top: .15rem;
        }

    /* CARD */

    .card-x {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
    }

    /* FILTER */

    .filter-bar {
        padding: 1rem 1.1rem;
    }

    .f-search {
        position: relative;
    }

        .f-search svg {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .f-search input {
            width: 100%;
            border: 1px solid var(--line);
            background: var(--cream);
            border-radius: 11px;
            padding: .62rem .9rem .62rem 2.3rem;
            font-size: .9rem;
            outline: none;
            color: var(--navy);
        }

            .f-search input:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.1);
            }

    .f-select {
        width: 100%;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 11px;
        padding: .62rem 2rem .62rem .9rem;
        font-size: .88rem;
        font-weight: 500;
        color: var(--navy);
        outline: none;
        cursor: pointer;
    }

        .f-select:focus {
            border-color: var(--teal);
        }

    .btn-clear {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 11px;
        padding: .62rem 1rem;
        font-size: .86rem;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: .2s;
        white-space: nowrap;
        width: 100%;
    }

        .btn-clear:hover {
            border-color: var(--cancel-fg);
            color: var(--cancel-fg);
        }

    .result-line {
        font-size: .86rem;
        color: var(--muted);
        margin: .2rem 0 1rem;
        padding: 0 .2rem;
    }

        .result-line b {
            color: var(--navy);
            font-weight: 600;
        }

    /* TABLE */

    .tbl-wrap {
        overflow-x: auto;
    }

    table.tx {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 1100px;
    }

        table.tx th {
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--muted);
            font-weight: 600;
            text-align: left;
            padding: .75rem 1rem;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        table.tx td {
            padding: .8rem 1rem;
            border-bottom: 1px solid var(--line-2);
            font-size: .88rem;
            color: var(--navy);
            vertical-align: middle;
        }

        table.tx tbody tr {
            transition: .15s;
        }

            table.tx tbody tr:hover {
                background: var(--cream);
            }

    .reservation-cell {
        display: flex;
        align-items: center;
        gap: .7rem;
        min-width: 240px;
    }

        .reservation-cell img {
            width: 52px;
            height: 52px;
            border-radius: 11px;
            object-fit: cover;
            flex: none;
        }

        .reservation-cell b {
            font-family: 'Sora';
            font-weight: 600;
            font-size: .9rem;
            color: var(--navy);
            display: block;
            line-height: 1.25;
        }

        .reservation-cell span {
            font-size: .78rem;
            color: var(--teal-dark);
            font-weight: 500;
        }

    .reservation-id {
        font-size: .75rem;
        color: var(--muted);
        font-family: 'Sora';
    }

    .people-count {
        display: flex;
        gap: .4rem;
        align-items: center;
        white-space: nowrap;
    }

    .people-badge {
        background: var(--cream);
        border: 1px solid var(--line);
        padding: .25rem .55rem;
        border-radius: 8px;
        font-size: .76rem;
        color: var(--navy);
    }

    .amount {
        font-family: 'Sora';
        font-weight: 600;
        white-space: nowrap;
    }

    .date-cell {
        white-space: nowrap;
        color: var(--muted);
        font-size: .82rem;
    }

    .badge-x {
        font-size: .74rem;
        font-weight: 600;
        padding: .28rem .7rem;
        border-radius: 999px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .badge-x::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .b-ok {
        background: var(--ok-bg);
        color: var(--ok-fg);
    }

    .b-pasif {
        background: var(--cancel-bg);
        color: var(--cancel-fg);
    }

    .b-taslak {
        background: var(--wait-bg);
        color: var(--wait-fg);
    }

    /* ACTION */

    .act-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid var(--line);
        display: grid;
        place-items: center;
        color: var(--muted);
        cursor: pointer;
        transition: .2s;
    }

        .act-btn:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    .dropdown-menu {
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: var(--shadow-md);
        padding: .4rem;
        font-size: .88rem;
        min-width: 180px;
    }

    .dropdown-item {
        border-radius: 8px;
        padding: .5rem .7rem;
        font-weight: 500;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .dropdown-item:hover {
            background: var(--cream);
            color: var(--teal-dark);
        }

        .dropdown-item.danger {
            color: var(--cancel-fg);
        }

            .dropdown-item.danger:hover {
                background: var(--cancel-bg);
            }

    /* PAGINATION */

    .pager-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1rem 1.1rem;
    }

    .pager {
        display: flex;
        gap: .35rem;
    }

        .pager a {
            min-width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: #fff;
            border: 1px solid var(--line);
            color: var(--navy);
            font-weight: 600;
            font-size: .88rem;
            transition: .2s;
            padding: 0 .3rem;
        }

            .pager a:hover {
                border-color: var(--teal);
                color: var(--teal-dark);
            }

            .pager a.active {
                background: var(--navy);
                color: #fff;
                border-color: var(--navy);
            }
</style>

<div class="content">

    <!-- INTRO -->

    <div class="crumb">
        <a href="/Admin/Dashboard/Index">Dashboard</a>
        /
        <span class="cur">Rezervasyonlar</span>
    </div>

    <div class="page-intro">

        <div>
            <h1>Rezervasyon Yönetimi</h1>

            <p>
                Travelio'daki tüm rezervasyonları görüntüleyebilir
                ve yönetebilirsiniz.
            </p>
        </div>

    </div>


    <!-- KPI -->

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic">

                    <svg width="20" height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />

                    </svg>

                </div>

                <div>
                    <div class="num">@Model.Count</div>
                    <div class="lab">Toplam Rezervasyon</div>
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic">

                    <svg width="20" height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <polyline points="20 6 9 17 4 12" />

                    </svg>

                </div>

                <div>
                    <div class="num">
                        @Model.Count(x => x.ReservationStatus == ReservationStatus.Onaylandı)
                    </div>

                    <div class="lab">Onaylanan</div>
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic gray">

                    <svg width="20" height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="12" cy="12" r="10" />
                        <line x1="8" y1="12" x2="16" y2="12" />

                    </svg>

                </div>

                <div>
                    <div class="num">
                        @Model.Count(x => x.ReservationStatus == ReservationStatus.İptal)
                    </div>

                    <div class="lab">İptal Edilen</div>
                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic warn">

                    <svg width="20" height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />

                    </svg>

                </div>

                <div>
                    <div class="num">
                        @Model.Sum(x => x.TotalPrice).ToString("N0") TL
                    </div>

                    <div class="lab">Toplam Ciro</div>
                </div>

            </div>

        </div>

    </div>


    <!-- FILTER -->

    <div class="card-x filter-bar mb-3">

        <div class="row g-2 align-items-center">

            <div class="col-lg-5 col-md-6">

                <div class="f-search">

                    <svg width="16" height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21"
                              x2="16.65"
                              y2="16.65" />

                    </svg>

                    <input type="text"
                           id="fSearch"
                           placeholder="Tur adı veya rezervasyon ID ara...">

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <select class="f-select" id="fStatus">

                    <option value="">Tüm Durumlar</option>

                    <option value="Confirmed">Onaylandı</option>
                    <option value="Pending">Bekliyor</option>
                    <option value="Cancelled">İptal</option>
                    <option value="Completed">Tamamlandı</option>

                </select>

            </div>

            <div class="col-lg-3 col-md-6">

                <select class="f-select" id="fDate">

                    <option value="">Tüm Tarihler</option>
                    <option value="today">Bugün</option>
                    <option value="week">Bu Hafta</option>
                    <option value="month">Bu Ay</option>

                </select>

            </div>

            <div class="col-lg-1 col-md-6">

                <button class="btn-clear"
                        onclick="clearFilters()">

                    Temizle

                </button>

            </div>

        </div>

    </div>


    <div class="result-line">

        <b>@Model.Count</b>
        rezervasyon listeleniyor

    </div>


    <!-- TABLE -->

    <div class="card-x mb-3">

        <div class="tbl-wrap">

            <table class="tx">

                <thead>

                    <tr>

                        <th>Rezervasyon</th>

                        <th>Tur</th>

                        <th>Kişi</th>

                        <th>Toplam Fiyat</th>

                        <th>Rezervasyon Tarihi</th>

                        <th>Tur Tarihi</th>

                        <th>Durum</th>

                        <th style="width:56px">
                            İşlemler
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var reservation in Model)
                    {
                        <tr>

                            <td>

                                <div class="reservation-cell">

                                    <div>
                                        <b>
                                            #@reservation.Id.Substring(0, Math.Min(8, reservation.Id.Length))
                                        </b>

                                        <span>
                                            @reservation.ReservationCreatedDate.ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    </div>

                                </div>

                            </td>


                            <td>

                                <div class="reservation-cell">

                                    @if (!string.IsNullOrEmpty(reservation.TourImageUrl))
                                    {
                                        <img src="@reservation.TourImageUrl"
                                             alt="@reservation.TourName">
                                    }

                                    <div>

                                        <b>
                                            @reservation.TourName
                                        </b>

                                        <span>
                                            @reservation.TourType
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <div class="people-count">

                                    <span class="people-badge">
                                        @reservation.Adult Yetişkin
                                    </span>

                                    @if (reservation.Child > 0)
                                    {
                                        <span class="people-badge">
                                            @reservation.Child Çocuk
                                        </span>
                                    }

                                </div>

                            </td>


                            <td>

                                <span class="amount">
                                    @reservation.TotalPrice.ToString("N0") TL
                                </span>

                            </td>


                            <td class="date-cell">

                                @reservation.ReservationCreatedDate.ToString("dd.MM.yyyy")
                                <br />
                                @reservation.ReservationCreatedDate.ToString("HH:mm")

                            </td>


                            <td class="date-cell">

                                @reservation.StartDate.ToString("dd.MM.yyyy")
                                -
                                @reservation.EndDate.ToString("dd.MM.yyyy")

                            </td>


                            <td>

                                @{
                                    var statusClass =
                                    reservation.ReservationStatus == ReservationStatus.Onaylandı
                                    ? "b-ok"
                                    : reservation.ReservationStatus == ReservationStatus.İptal
                                    ? "b-pasif"
                                    : "b-taslak";
                                }

                                <span class="badge-x @statusClass">
                                    @reservation.ReservationStatus
                                </span>

                            </td>


                            <td>

                                <div class="dropdown">

                                    <button type="button"
                                            class="act-btn"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">

                                        ⋮

                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                       
                                        <li>

                                            <a class="dropdown-item"
                                               href="/Admin/Reservation/ConfirmReservation/@reservation.Id">

                                                Onayla

                                            </a>

                                        </li>

                                        <li>

                                            <a class="dropdown-item"
                                               href="/Admin/Reservation/CancelReservation/@reservation.Id">

                                                İptal Et

                                            </a>

                                        </li>

                                       
                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <div class="pager-row">

            <div class="per-page">

                Sayfa başına

                <select>
                    <option>10</option>
                    <option>25</option>
                    <option>50</option>
                </select>

            </div>


            <div class="pager">

                <a href="#" class="disabled">
                    Önceki
                </a>

                <a href="#" class="active">
                    1
                </a>

                <a href="#">
                    2
                </a>

                <a href="#">
                    3
                </a>

                <a href="#">
                    Sonraki
                </a>

            </div>

        </div>

    </div>

</div>