@using Travel.Web.DTOs.TourDtos
@model CreateTourDto

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --navy: #0e2a3b;
        --navy-2: #12384c;
        --navy-3: #1b455c;
        --teal: #0fa3a3;
        --teal-dark: #0b7f80;
        --cream: #f7f5f0;
        --bg: #f4f5f4;
        --white: #fff;
        --ink: #0e2a3b;
        --muted: #6a7c88;
        --line: #e7e2d8;
        --line-2: #eef0ef;
        --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
        --shadow-md: 0 18px 50px rgba(14,42,59,.12);
        --sidebar-w: 266px;
        --r: 16px;
        --ok-bg: #e3f4f0;
        --ok-fg: #0b7f80;
        --wait-bg: #fbf1dc;
        --wait-fg: #a9741a;
        --cancel-bg: #f6e4e2;
        --cancel-fg: #b45a4f;
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
        background: var(--bg);
        margin: 0;
        -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, .brand {
        font-family: 'Sora', sans-serif;
    }

    a {
        text-decoration: none;
    }

    .eyebrow {
        font-family: 'Sora', sans-serif;
        text-transform: uppercase;
        letter-spacing: .2em;
        font-size: .7rem;
        font-weight: 700;
        color: var(--teal-dark);
    }

    /* SIDEBAR */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-w);
        background: var(--navy);
        display: flex;
        flex-direction: column;
        z-index: 1045;
    }

    .sb-brand {
        padding: 1.5rem 1.5rem 1.3rem;
        display: flex;
        align-items: center;
        gap: .65rem;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

        .sb-brand .dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: var(--teal);
            box-shadow: 0 0 0 4px rgba(15,163,163,.22);
            flex: none;
        }

        .sb-brand .txt b {
            font-family: 'Sora';
            font-weight: 800;
            color: #fff;
            font-size: 1.25rem;
            letter-spacing: -.4px;
            display: block;
            line-height: 1;
        }

        .sb-brand .txt span {
            font-size: .7rem;
            color: #7fe3e3;
            letter-spacing: .16em;
            text-transform: uppercase;
            font-weight: 600;
        }

    .sb-menu {
        flex: 1;
        overflow-y: auto;
        padding: 1rem .8rem;
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .sb-cap {
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: rgba(255,255,255,.35);
        font-weight: 600;
        padding: .4rem .8rem .3rem;
    }

    .sb-link {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .65rem .85rem;
        border-radius: 11px;
        color: rgba(255,255,255,.72);
        font-weight: 500;
        font-size: .92rem;
        transition: .18s;
        position: relative;
    }

        .sb-link svg {
            flex: none;
            opacity: .85;
        }

        .sb-link:hover {
            background: rgba(255,255,255,.07);
            color: #fff;
        }

        .sb-link.active {
            background: var(--teal);
            color: #fff;
            box-shadow: 0 8px 20px rgba(15,163,163,.28);
        }

            .sb-link.active svg {
                opacity: 1;
            }

    .sb-badge {
        margin-left: auto;
        background: rgba(255,255,255,.16);
        color: #fff;
        font-size: .7rem;
        font-weight: 700;
        padding: .1rem .45rem;
        border-radius: 999px;
    }

    .sb-foot {
        padding: .8rem;
        border-top: 1px solid rgba(255,255,255,.08);
    }

    .sb-user {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .6rem .7rem;
        border-radius: 12px;
        background: rgba(255,255,255,.05);
    }

        .sb-user .av {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--teal);
            color: #fff;
            display: grid;
            place-items: center;
            font-family: 'Sora';
            font-weight: 700;
            font-size: .85rem;
            flex: none;
        }

        .sb-user b {
            display: block;
            color: #fff;
            font-size: .86rem;
            font-family: 'Sora';
            line-height: 1.2;
        }

        .sb-user span {
            font-size: .74rem;
            color: rgba(255,255,255,.55);
        }

    /* MAIN */
    .main {
        margin-left: var(--sidebar-w);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .topbar {
        position: sticky;
        top: 0;
        z-index: 1030;
        background: rgba(244,245,244,.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
        padding: .85rem 1.8rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .hamb {
        display: none;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
        width: 40px;
        height: 40px;
        place-items: center;
        color: var(--navy);
        cursor: pointer;
    }

    .topbar .tb-title {
        font-family: 'Sora';
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--navy);
    }

    .tb-search {
        margin-left: .5rem;
        position: relative;
        flex: 1;
        max-width: 320px;
    }

        .tb-search svg {
            position: absolute;
            left: .8rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .tb-search input {
            width: 100%;
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 999px;
            padding: .55rem .9rem .55rem 2.3rem;
            font-size: .88rem;
            outline: none;
            color: var(--navy);
        }

            .tb-search input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(15,163,163,.1);
            }

    .tb-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: .9rem;
    }

    .tb-icon {
        position: relative;
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: #fff;
        border: 1px solid var(--line);
        display: grid;
        place-items: center;
        color: var(--navy);
        cursor: pointer;
        transition: .2s;
    }

        .tb-icon:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

        .tb-icon .n-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #e0575b;
            color: #fff;
            font-size: .66rem;
            font-weight: 700;
            min-width: 17px;
            height: 17px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            padding: 0 3px;
        }

    .tb-user {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding-left: .4rem;
    }

        .tb-user .av {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--navy);
            color: #fff;
            display: grid;
            place-items: center;
            font-family: 'Sora';
            font-weight: 700;
            font-size: .82rem;
        }

        .tb-user .nm {
            line-height: 1.15;
        }

            .tb-user .nm b {
                font-family: 'Sora';
                font-size: .86rem;
                color: var(--navy);
                display: block;
            }

            .tb-user .nm span {
                font-size: .74rem;
                color: var(--muted);
            }

    .content {
        padding: 1.8rem;
        flex: 1;
        max-width: 1100px;
    }

    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .15rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
            max-width: 64ch;
        }

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .7rem 1.3rem;
        font-size: .9rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            box-shadow: 0 12px 26px rgba(15,163,163,.3);
        }

    .btn-ghost {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-weight: 600;
        padding: .65rem 1.2rem;
        font-size: .88rem;
        color: var(--navy);
        transition: .2s;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-ghost:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    .btn-navy {
        background: var(--navy);
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .7rem 1.3rem;
        font-size: .9rem;
        color: #fff;
        transition: .2s;
        cursor: pointer;
    }

        .btn-navy:hover {
            background: var(--navy-2);
        }

    .btn-add {
        background: rgba(15,163,163,.08);
        border: 1px dashed rgba(15,163,163,.4);
        color: var(--teal-dark);
        border-radius: 11px;
        font-weight: 600;
        padding: .6rem 1rem;
        font-size: .86rem;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        cursor: pointer;
        transition: .2s;
    }

        .btn-add:hover {
            background: rgba(15,163,163,.14);
            border-style: solid;
        }

    /* SECTION CARD */
    .sec {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        padding: 1.5rem 1.6rem;
        margin-bottom: 1.3rem;
    }

    .sec-head {
        margin-bottom: 1.2rem;
    }

        .sec-head h2 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.12rem;
            color: var(--navy);
            margin: 0;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .sec-head .sec-ic {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            flex: none;
        }

        .sec-head p {
            color: var(--muted);
            font-size: .86rem;
            margin: .4rem 0 0;
        }

    /* FIELDS */
    .field {
        margin-bottom: 1rem;
    }

        .field label {
            display: block;
            font-size: .8rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: .35rem;
        }

            .field label .req {
                color: var(--cancel-fg);
            }

    .ctrl {
        width: 100%;
        border: 1px solid var(--line);
        background: var(--cream);
        border-radius: 11px;
        padding: .68rem .9rem;
        font-size: .9rem;
        color: var(--navy);
        outline: none;
        transition: .2s;
        font-family: inherit;
    }

        .ctrl::placeholder {
            color: #a7b2ba;
        }

        .ctrl:focus {
            border-color: var(--teal);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(15,163,163,.12);
        }

    select.ctrl {
        cursor: pointer;
        padding-right: 2rem;
    }

    textarea.ctrl {
        resize: vertical;
        min-height: 80px;
        line-height: 1.6;
    }

    .input-group-x {
        position: relative;
    }

        .input-group-x .suffix {
            position: absolute;
            right: .9rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: .85rem;
            font-weight: 600;
            color: var(--muted);
        }

    .ctrl.err {
        border-color: var(--cancel-fg);
        background: #fdf3f1;
        box-shadow: 0 0 0 3px rgba(180,90,79,.12);
    }

    /* DYNAMIC DATE ROWS */
    .drow {
        display: flex;
        gap: .7rem;
        align-items: flex-end;
        background: var(--cream);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: .8rem .9rem;
        margin-bottom: .7rem;
        flex-wrap: wrap;
    }

        .drow .field {
            margin-bottom: 0;
            flex: 1;
            min-width: 130px;
        }

            .drow .field label {
                font-size: .72rem;
            }

        .drow .ctrl {
            background: #fff;
        }

    .del-mini {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid var(--line);
        color: var(--cancel-fg);
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: .2s;
        flex: none;
    }

        .del-mini:hover {
            background: var(--cancel-bg);
            border-color: var(--cancel-fg);
        }

        .del-mini:disabled {
            opacity: .35;
            cursor: not-allowed;
        }

    /* ITINERARY */
    .day {
        border: 1px solid var(--line);
        border-radius: 12px;
        margin-bottom: .7rem;
        overflow: hidden;
        background: #fff;
    }

        .day.open {
            box-shadow: var(--shadow-sm);
            border-color: rgba(15,163,163,.4);
        }

    .day-head {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .85rem 1rem;
        cursor: pointer;
        user-select: none;
    }

    .day-tag {
        font-family: 'Sora';
        font-weight: 700;
        font-size: .72rem;
        color: var(--teal-dark);
        background: rgba(15,163,163,.1);
        padding: .3rem .65rem;
        border-radius: 999px;
        white-space: nowrap;
        flex: none;
    }

    .day-name {
        font-family: 'Sora';
        font-weight: 600;
        color: var(--navy);
        font-size: .92rem;
        flex: 1;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .day-actions {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex: none;
    }

    .day-chev {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--cream);
        display: grid;
        place-items: center;
        color: var(--navy);
        transition: .3s;
    }

    .day.open .day-chev {
        background: var(--navy);
        color: #fff;
        transform: rotate(180deg);
    }

    .day-body {
        max-height: 0;
        overflow: hidden;
        transition: max-height .3s ease;
    }

    .day-inner {
        padding: 0 1rem 1.1rem;
    }

    /* DYNAMIC LIST */
    .litem {
        display: flex;
        gap: .6rem;
        align-items: center;
        margin-bottom: .6rem;
    }

        .litem .ctrl {
            background: #fff;
        }

    /* UPLOAD */
    .upload {
        border: 1.5px dashed var(--line);
        border-radius: 14px;
        padding: 1.8rem 1rem;
        text-align: center;
        background: var(--cream);
        cursor: pointer;
        transition: .2s;
    }

        .upload:hover {
            border-color: var(--teal);
            background: rgba(15,163,163,.04);
        }

        .upload .uic {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid var(--line);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin: 0 auto .7rem;
        }

        .upload b {
            font-family: 'Sora';
            font-size: .9rem;
            color: var(--navy);
            display: block;
        }

        .upload span {
            font-size: .78rem;
            color: var(--muted);
        }

    .previews {
        display: flex;
        flex-wrap: wrap;
        gap: .6rem;
        margin-top: .9rem;
    }

    .thumb {
        width: 74px;
        height: 60px;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid var(--line);
    }

    .cover-preview {
        margin-top: .9rem;
        border-radius: 12px;
        overflow: hidden;
        max-width: 280px;
        border: 1px solid var(--line);
    }

        .cover-preview img {
            width: 100%;
            display: block;
        }

    /* SWITCHES */
    .switch-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .7rem 0;
        border-top: 1px solid var(--line-2);
    }

        .switch-row:first-of-type {
            border-top: none;
        }

        .switch-row .sl b {
            font-family: 'Sora';
            font-size: .9rem;
            color: var(--navy);
            display: block;
        }

        .switch-row .sl span {
            font-size: .78rem;
            color: var(--muted);
        }

    .form-check-input {
        width: 2.6em;
        height: 1.4em;
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: var(--teal);
            border-color: var(--teal);
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 3px rgba(15,163,163,.15);
            border-color: var(--teal);
        }

    .status-pills {
        display: flex;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .status-pill {
        flex: 1;
        min-width: 120px;
        border: 1px solid var(--line);
        border-radius: 11px;
        padding: .7rem .9rem;
        cursor: pointer;
        transition: .2s;
        background: var(--cream);
    }

        .status-pill:hover {
            border-color: var(--teal);
        }

        .status-pill.sel {
            border-color: var(--teal);
            background: rgba(15,163,163,.06);
            box-shadow: 0 0 0 2px rgba(15,163,163,.12);
        }

        .status-pill b {
            font-family: 'Sora';
            font-size: .9rem;
            color: var(--navy);
            display: block;
        }

        .status-pill span {
            font-size: .76rem;
            color: var(--muted);
        }

        .status-pill input {
            display: none;
        }

    /* VALIDATION */
    .val-banner {
        display: none;
        background: #fdf3f1;
        border: 1px solid rgba(180,90,79,.3);
        color: var(--cancel-fg);
        border-radius: 12px;
        padding: .85rem 1.1rem;
        margin-bottom: 1.3rem;
        font-size: .88rem;
    }

        .val-banner.show {
            display: block;
        }

        .val-banner b {
            font-family: 'Sora';
        }

        .val-banner ul {
            margin: .3rem 0 0;
            padding-left: 1.1rem;
        }

    /* ACTION BAR */
    .action-bar {
        position: sticky;
        bottom: 0;
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(10px);
        border: 1px solid var(--line-2);
        border-radius: 14px;
        box-shadow: var(--shadow-md);
        padding: .9rem 1.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: .4rem;
        margin-bottom: .4rem;
    }

        .action-bar .saved {
            font-size: .83rem;
            color: var(--muted);
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .action-bar .btns {
            display: flex;
            gap: .6rem;
            flex-wrap: wrap;
        }

    .admin-foot {
        padding: 1.1rem 1.8rem;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: .82rem;
        color: var(--muted);
    }

    .toast-ok {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: var(--navy);
        color: #fff;
        padding: .9rem 1.3rem;
        border-radius: 14px;
        box-shadow: var(--shadow-md);
        font-size: .9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .6rem;
        z-index: 1080;
        opacity: 0;
        transform: translateY(12px);
        transition: .3s;
        pointer-events: none;
    }

        .toast-ok.show {
            opacity: 1;
            transform: none;
        }

        .toast-ok svg {
            color: #7fe3e3;
        }

    @@media (max-width: 1100px) {
        .sidebar {
            transform: translateX(-100%);
            transition: transform .3s ease;
        }

            .sidebar.show {
                transform: none;
            }

        .main {
            margin-left: 0;
        }

        .hamb {
            display: grid;
        }
    }

    @@media (max-width: 575px) {
        .content {
            padding: 1.1rem;
        }

        .tb-search {
            display: none;
        }

        .tb-user .nm {
            display: none;
        }

        .topbar {
            padding: .8rem 1rem;
        }
