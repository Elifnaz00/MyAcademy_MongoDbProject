<!-- TOAST -->
<div class="toast-ok" id="toast">

    <svg width="18" height="18"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2.5"
         stroke-linecap="round"
         stroke-linejoin="round">

        <polyline points="20 6 9 17 4 12" />

    </svg>

    <span id="toastMsg">Kaydedildi.</span>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

    /* =========================================================
       TOAST
    ========================================================= */

    function toast(message) {

        const toastElement = document.getElementById("toast");
        const toastMessage = document.getElementById("toastMsg");

        if (!toastElement || !toastMessage)
            return;

        toastMessage.textContent = message;

        toastElement.classList.add("show");

        setTimeout(() => {
            toastElement.classList.remove("show");
        }, 2600);
    }


    /* =========================================================
       TUR TARİHLERİ
       List<TourDate>
    ========================================================= */

    const dateList = document.getElementById("dateList");


    function dateRowHTML(
        index,
        start = "",
        end = "",
        quota = "",
        isActive = true
    ) {

        return `
            <div class="drow">

                <div class="field">
                    <label>Başlangıç Tarihi</label>

                    <input type="date"
                           name="TourDates[${index}].StartDate"
                           class="ctrl d-start"
                           value="${start}">
                </div>


                <div class="field">
                    <label>Bitiş Tarihi</label>

                    <input type="date"
                           name="TourDates[${index}].EndDate"
                           class="ctrl d-end"
                           value="${end}">
                </div>


                <div class="field" style="max-width:120px">
                    <label>Kontenjan</label>

                    <input type="number"
                           name="TourDates[${index}].Quota"
                           class="ctrl d-cap"
                           min="1"
                           value="${quota}"
                           placeholder="28">
                </div>


                <div class="field" style="max-width:130px">
                    <label>Durum</label>

                    <select name="TourDates[${index}].IsActive"
                            class="ctrl d-status">

                        <option value="true"
                            ${isActive === true ? "selected" : ""}>
                            Aktif
                        </option>

                        <option value="false"
                            ${isActive === false ? "selected" : ""}>
                            Pasif
                        </option>

                    </select>
                </div>


                <button type="button"
                        class="del-mini"
                        onclick="removeDate(this)"
                        aria-label="Sil">

                    <svg width="16" height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>

                    </svg>

                </button>

            </div>
        `;
    }


    function addDate() {

        const index =
            dateList.querySelectorAll(".drow").length;

        dateList.insertAdjacentHTML(
            "beforeend",
            dateRowHTML(index)
        );

        refreshDateIndexes();
        refreshDateDeleteButtons();
    }


    function removeDate(button) {

        const rows =
            dateList.querySelectorAll(".drow");

        if (rows.length <= 1)
            return;

        button.closest(".drow").remove();

        refreshDateIndexes();
        refreshDateDeleteButtons();
    }


    function refreshDateIndexes() {

        const rows =
            dateList.querySelectorAll(".drow");

        rows.forEach((row, index) => {

            row.querySelector(".d-start").name =
                `TourDates[${index}].StartDate`;

            row.querySelector(".d-end").name =
                `TourDates[${index}].EndDate`;

            row.querySelector(".d-cap").name =
                `TourDates[${index}].Quota`;

            row.querySelector(".d-status").name =
                `TourDates[${index}].IsActive`;

        });
    }


    function refreshDateDeleteButtons() {

        const rows =
            dateList.querySelectorAll(".drow");

        rows.forEach(row => {

            row.querySelector(".del-mini").disabled =
                rows.length <= 1;

        });
    }


    /* İlk tarih */

    dateList.insertAdjacentHTML(
        "beforeend",
        dateRowHTML(
            0,
            "2026-10-12",
            "2026-10-17",
            28,
            true
        )
    );

    refreshDateIndexes();
    refreshDateDeleteButtons();


    /* =========================================================
       GÜN GÜN TUR PROGRAMI
       List<TourItinerary>
    ========================================================= */

    const dayList =
        document.getElementById("dayList");


    function dayHTML(
        index,
        open = true,
        title = "",
        description = "",
        accommodation = "",
        transport = "",
        meal = ""
    ) {

        return `
            <div class="day ${open ? "open" : ""}">

                <div class="day-head"
                     onclick="toggleDay(this)">

                    <span class="day-tag">
                        ${index + 1}. GÜN
                    </span>

                    <span class="day-name">
                        ${title || "Yeni gün"}
                    </span>


                    <div class="day-actions">

                        <button type="button"
                                class="del-mini"
                                onclick="removeDay(event, this)">

                            <svg width="15" height="15"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>

                            </svg>

                        </button>


                        <span class="day-chev">

                            <svg width="14" height="14"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2.5"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <polyline points="6 9 12 15 18 9"></polyline>

                            </svg>

                        </span>

                    </div>

                </div>


                <div class="day-body">

                    <div class="day-inner">

                        <input type="hidden"
                               class="day-number"
                               name="Itineraries[${index}].Day"
                               value="${index + 1}">


                        <div class="field">

                            <label>Gün Başlığı</label>

                            <input type="text"
                                   class="ctrl day-title"
                                   name="Itineraries[${index}].DayTitle"
                                   value="${title}"
                                   placeholder="Örn. İstanbul → Roma"
                                   oninput="syncDayName(this)">

                        </div>


                        <div class="field">

                            <label>Program Açıklaması</label>

                            <textarea class="ctrl"
                                      name="Itineraries[${index}].ProgramDescription"
                                      rows="3"
                                      placeholder="Günün programını yazın...">${description}</textarea>

                        </div>


                        <div class="row g-2">

                            <div class="col-md-4 field"
                                 style="margin-bottom:0">

                                <label>Konaklama</label>

                                <input type="text"
                                       class="ctrl"
                                       name="Itineraries[${index}].Accomodation"
                                       value="${accommodation}"
                                       placeholder="Roma">

                            </div>


                            <div class="col-md-4 field"
                                 style="margin-bottom:0">

                                <label>Ulaşım</label>

                                <input type="text"
                                       class="ctrl"
                                       name="Itineraries[${index}].TransportType"
                                       value="${transport}"
                                       placeholder="Uçak + Transfer">

                            </div>


                            <div class="col-md-4 field"
                                 style="margin-bottom:0">

                                <label>Öğün</label>

                                <input type="text"
                                       class="ctrl"
                                       name="Itineraries[${index}].Meal"
                                       value="${meal}"
                                       placeholder="Kahvaltı">

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        `;
    }


    function addDay() {

        const index =
            dayList.querySelectorAll(".day").length;

        dayList.insertAdjacentHTML(
            "beforeend",
            dayHTML(index)
        );

        const lastDay =
            dayList.lastElementChild;

        const body =
            lastDay.querySelector(".day-body");

        body.style.maxHeight =
            body.scrollHeight + 80 + "px";

        refreshItineraryIndexes();
        refreshDayDeleteButtons();
    }


    function removeDay(event, button) {

        event.stopPropagation();

        const days =
            dayList.querySelectorAll(".day");

        if (days.length <= 1)
            return;

        button.closest(".day").remove();

        refreshItineraryIndexes();
        refreshDayDeleteButtons();
    }


    function refreshItineraryIndexes() {

        const days =
            dayList.querySelectorAll(".day");

        days.forEach((day, index) => {

            const dayNumber =
                day.querySelector(".day-number");

            const dayTitle =
                day.querySelector(".day-title");

            const description =
                day.querySelector("textarea");

            const inputs =
                day.querySelectorAll(".row .ctrl");


            dayNumber.name =
                `Itineraries[${index}].Day`;

            dayNumber.value =
                index + 1;


            dayTitle.name =
                `Itineraries[${index}].DayTitle`;


            description.name =
                `Itineraries[${index}].ProgramDescription`;


            inputs[0].name =
                `Itineraries[${index}].Accomodation`;

            inputs[1].name =
                `Itineraries[${index}].TransportType`;

            inputs[2].name =
                `Itineraries[${index}].Meal`;


            day.querySelector(".day-tag").textContent =
                `${index + 1}. GÜN`;

        });
    }


    function refreshDayDeleteButtons() {

        const days =
            dayList.querySelectorAll(".day");

        days.forEach(day => {

            day.querySelector(".del-mini").disabled =
                days.length <= 1;

        });
    }


    function toggleDay(head) {

        const day =
            head.closest(".day");

        const body =
            day.querySelector(".day-body");


        if (day.classList.contains("open")) {

            day.classList.remove("open");

            body.style.maxHeight = "0";

        }
        else {

            day.classList.add("open");

            body.style.maxHeight =
                body.scrollHeight + 80 + "px";
        }
    }


    function syncDayName(input) {

        const day =
            input.closest(".day");

        const index =
            [...dayList.querySelectorAll(".day")]
                .indexOf(day) + 1;

        day.querySelector(".day-name").textContent =
            input.value.trim()
                ? input.value
                : `${index}. gün`;
    }


    /* İlk gün */

    dayList.insertAdjacentHTML(
        "beforeend",
        dayHTML(
            0,
            true,
            "İstanbul → Roma",
            "İstanbul Havalimanı'nda buluşma, Roma uçuşu, havalimanı transferi ve otele yerleşme. Akşam serbest zaman.",
            "Roma",
            "Uçak + Transfer",
            "Kahvaltı"
        )
    );


    const firstDay =
        dayList.firstElementChild;

    const firstBody =
        firstDay.querySelector(".day-body");

    firstBody.style.maxHeight =
        firstBody.scrollHeight + 80 + "px";

    refreshItineraryIndexes();
    refreshDayDeleteButtons();


    /* =========================================================
       HİZMETLER / ÖZELLİKLER
       List<string>
    ========================================================= */

    function itemHTML(
        placeholder,
        value = "",
        inputName
    ) {

        return `
            <div class="litem">

                <input type="text"
                       name="${inputName}"
                       class="ctrl"
                       placeholder="${placeholder}"
                       value="${value}">

                <button type="button"
                        class="del-mini"
                        onclick="removeItem(this)">

                    <svg width="15" height="15"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>

                    </svg>

                </button>

            </div>
        `;
    }


    function addItem(
        listId,
        placeholder,
        inputName
    ) {

        const list =
            document.getElementById(listId);

        list.insertAdjacentHTML(
            "beforeend",
            itemHTML(
                placeholder,
                "",
                inputName
            )
        );
    }


    function removeItem(button) {

        button.closest(".litem").remove();
    }


    /* İlk hizmetler */

    document
        .getElementById("incList")
        .insertAdjacentHTML(
            "beforeend",
            itemHTML(
                "Yeni hizmet",
                "Gidiş-dönüş uçak bileti",
                "PriceIncludes"
            )
        );


    document
        .getElementById("excList")
        .insertAdjacentHTML(
            "beforeend",
            itemHTML(
                "Yeni madde",
                "Kişisel harcamalar",
                "NotPriceIncludes"
            )
        );


    document
        .getElementById("hlList")
        .insertAdjacentHTML(
            "beforeend",
            itemHTML(
                "Öne çıkan özellik",
                "Profesyonel Türkçe rehber",
                "Features"
            )
        );


    /* =========================================================
       TUR DURUMU
    ========================================================= */

    const statusPills =
        document.querySelectorAll(".status-pill");


    statusPills.forEach(pill => {

        const radio =
            pill.querySelector("input[type='radio']");

        pill.addEventListener("click", function () {

            radio.checked = true;

            statusPills.forEach(item => {
                item.classList.remove("sel");
            });

            pill.classList.add("sel");
        });
    });


    /* =========================================================
       ROZETLER
    ========================================================= */

    function oneBadge(current, otherId) {

        if (!current.checked)
            return;

        const other =
            document.getElementById(otherId);

        if (other)
            other.checked = false;
    }


    /* =========================================================
       GÖRSEL ÖNİZLEME
    ========================================================= */

    function previewCover(input) {

        const preview =
            document.getElementById("coverPreview");

        const image =
            document.getElementById("coverImg");


        if (!input.files || !input.files[0])
            return;


        const reader =
            new FileReader();


        reader.onload = function (event) {

            image.src =
                event.target.result;

            preview.style.display =
                "block";
        };


        reader.readAsDataURL(input.files[0]);
    }


    function previewGallery(input) {

        const preview =
            document.getElementById("galleryPreviews");


        preview.innerHTML = "";


        if (!input.files)
            return;


        const files =
            [...input.files].slice(0, 8);


        files.forEach(file => {

            const reader =
                new FileReader();


            reader.onload = function (event) {

                const image =
                    document.createElement("img");

                image.src =
                    event.target.result;

                image.className =
                    "thumb";

                image.alt =
                    "Galeri görseli";


                preview.appendChild(image);
            };


            reader.readAsDataURL(file);
        });
    }


    /* =========================================================
       FORM
    ========================================================= */

    const tourForm =
        document.getElementById("tourForm");


    function setState(state) {

        const radio =
            document.querySelector(
                `input[name="State"][value="${state}"]`
            );

        if (!radio)
            return;


        radio.checked = true;


        statusPills.forEach(pill => {

            pill.classList.remove("sel");

            const pillRadio =
                pill.querySelector("input");

            if (pillRadio === radio) {
                pill.classList.add("sel");
            }

        });
    }


    function validateForm() {

        const errors = [];


        const name =
            document.getElementById("tName");

        const destination =
            document.getElementById("tDest");

        const category =
            document.getElementById("tCat");

        const price =
            document.getElementById("tPrice");

        const days =
            document.getElementById("tDays");


        if (!name.value.trim())
            errors.push("Tur adı");

        if (!destination.value)
            errors.push("Destinasyon");

        if (!category.value)
            errors.push("Kategori");

        if (!price.value)
            errors.push("Kişi başı fiyat");

        if (!days.value)
            errors.push("Gün");


        const valBanner =
            document.getElementById("valBanner");

        const valList =
            document.getElementById("valList");


        if (errors.length > 0) {

            valList.innerHTML =
                errors
                    .map(error => `<li>${error}</li>`)
                    .join("");


            valBanner.classList.add("show");

            valBanner.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

            return false;
        }


        valBanner.classList.remove("show");

        return true;
    }


    /* =========================================================
       TASLAK KAYDET / YAYINLA
    ========================================================= */

    function saveDraft() {

        setState("Draft");

        tourForm.requestSubmit();
    }


    function publishTour() {

        if (!validateForm())
            return;

        setState("Active");

        tourForm.requestSubmit();
    }


</script>