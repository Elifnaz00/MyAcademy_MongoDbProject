@using Travel.Web.DTOs.CommentDtos
@model List<ResultCommentDto>

@{
    ViewData["Title"] = "Yorumlarım";
    Layout = "_UserLayout";
}

<style>
    .my-comments {
        min-height: 70vh;
        padding: 45px 0 70px;
        background: #f7f5f0;
        color: #0e2a3b;
    }

    .comments-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .comments-header {
        margin-bottom: 32px;
    }

        .comments-header .eyebrow {
            color: #0fa3a3;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 10px;
            display: block;
        }

        .comments-header h1 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #0e2a3b;
        }

        .comments-header p {
            color: #71808a;
            font-size: 15px;
            margin: 0;
        }

    .comments-summary {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fff;
        padding: 20px 24px;
        border-radius: 14px;
        margin-bottom: 24px;
        border: 1px solid #e8e8e2;
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e5f6f4;
        color: #0fa3a3;
        border-radius: 12px;
        font-size: 22px;
        flex-shrink: 0;
    }

    .summary-number {
        font-size: 22px;
        font-weight: 700;
        color: #0e2a3b;
        line-height: 1.3;
    }

    .summary-label {
        font-size: 13px;
        color: #71808a;
    }

    .comment-card {
        background: #fff;
        border: 1px solid #e8e8e2;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 18px;
        transition: box-shadow .2s ease, transform .2s ease;
    }

        .comment-card:hover {
            box-shadow: 0 8px 24px rgba(14, 42, 59, .06);
            transform: translateY(-2px);
        }

    .comment-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 18px;
    }

    .tour-info {
        min-width: 0;
    }

    .tour-label {
        display: block;
        color: #0fa3a3;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .tour-name {
        font-size: 19px;
        font-weight: 700;
        color: #0e2a3b;
        margin: 0;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .comment-date {
        font-size: 13px;
        color: #7d8b93;
        white-space: nowrap;
        padding-top: 4px;
    }

    .comment-rating {
        display: flex;
        align-items: center;
        gap: 3px;
        margin-bottom: 14px;
    }

        .comment-rating .star {
            color: #f0b429;
            font-size: 18px;
        }

        .comment-rating .rating-value {
            color: #526570;
            font-size: 13px;
            font-weight: 600;
            margin-left: 6px;
        }

    .comment-content {
        background: #f8faf9;
        border-radius: 10px;
        padding: 18px;
        color: #425560;
        font-size: 14px;
        line-height: 1.8;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .comment-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid #edf0ed;
    }

    .author-info {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .author-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        background: #e5f6f4;
        flex-shrink: 0;
    }

    .author-name {
        font-size: 13px;
        font-weight: 600;
        color: #0e2a3b;
    }

    .comment-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #168477;
        background: #e5f6f0;
        border-radius: 20px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .empty-comments {
        text-align: center;
        padding: 60px 24px;
        background: #fff;
        border: 1px solid #e8e8e2;
        border-radius: 16px;
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e5f6f4;
        color: #0fa3a3;
        font-size: 30px;
    }

    .empty-comments h3 {
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #0e2a3b;
    }

    .empty-comments p {
        font-size: 14px;
        color: #71808a;
        margin: 0 auto 22px;
        max-width: 420px;
        line-height: 1.7;
    }

    .explore-btn {
        display: inline-block;
        background: #0e2a3b;
        color: #fff;
        padding: 12px 22px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: background .2s ease;
    }

        .explore-btn:hover {
            background: #0fa3a3;
            color: #fff;
        }

    @@media (max-width: 600px) {
        .my-comments {
            padding: 30px 0 45px;
        }

        .comments-container {
            padding: 0 16px;
        }

        .comments-header h1 {
            font-size: 26px;
        }

        .comment-card {
            padding: 18px;
        }

        .comment-top {
            flex-direction: column;
            gap: 8px;
        }

        .comment-date {
            white-space: normal;
        }

        .comment-footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<section class="my-comments">
    <div class="comments-container">

        <div class="comments-header">
            <span class="eyebrow">TRAVELIO · SEYAHAT GÜNLÜĞÜN</span>
            <h1>Yorumlarım</h1>
            <p>Deneyimlerini ve seyahat anılarını burada görüntüleyebilirsin.</p>
        </div>

        <div class="comments-summary">
            <div class="summary-icon">
                <i class="fa-regular fa-comments"></i>
            </div>
            <div>
                <div class="summary-number">@Model.Count</div>
                <div class="summary-label">Yaptığın yorum</div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            foreach (var comment in Model.OrderByDescending(x => x.CommentDate))
            {
                <article class="comment-card">

                    <div class="comment-top">
                        <div class="tour-info">
                            <span class="tour-label">Yorum yaptığın tur</span>
                            <h2 class="tour-name">
                                @(string.IsNullOrWhiteSpace(comment.TourName)
                                                        ? "Bilinmeyen Tur"
                                                        : comment.TourName)
                    </h2>
                </div>

                        <div class="comment-date">
                            <i class="fa-regular fa-calendar"></i>
                            @comment.CommentDate.ToString("dd.MM.yyyy")
                        </div>
                    </div>

                    <div class="comment-rating">
                @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= comment.CommentRating)
                            {
                                <i class="fa-solid fa-star star"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star star"></i>
                            }
                        }

                        <span class="rating-value">
                            @comment.CommentRating / 5
                        </span>
                    </div>

                    <div class="comment-content">@comment.CommentContent</div>

                    <div class="comment-footer">
                        <div class="author-info">
                            @if (!string.IsNullOrWhiteSpace(comment.UserImage))
                            {
                                <img src="@comment.UserImage"
                                     alt="Kullanıcı fotoğrafı"
                                     class="author-avatar" />
                            }
                            else
                            {
                                <div class="author-avatar d-flex align-items-center justify-content-center">
                                    <i class="fa-regular fa-user"></i>
                                </div>
                            }

                            <span class="author-name">
                                @comment.UserName @comment.UserSurname
                            </span>
                        </div>

                        <span class="comment-badge">
                            <i class="fa-solid fa-check"></i>
                            Yorumum
                        </span>
                    </div>

                </article>
            }
        }
        else
        {
            <div class="empty-comments">
                <div class="empty-icon">
                    <i class="fa-regular fa-comment-dots"></i>
                </div>

                <h3>Henüz yorumun yok</h3>

                <p>
                    Katıldığın turlar hakkındaki deneyimlerini paylaşarak
                    diğer gezginlere yardımcı olabilirsin.
                </p>

                <a asp-controller="Tour"
                   asp-action="Index"
                   class="explore-btn">
                    Turları Keşfet
                    <i class="fa-solid fa-arrow-right ms-2"></i>
                </a>
            </div>
        }

    </div>
</section>
