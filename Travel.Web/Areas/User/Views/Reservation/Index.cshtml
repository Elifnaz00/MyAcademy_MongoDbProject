@model List<Travel.Web.DTOs.ReservationDtos.ResultReservationDto>

@{
    ViewData["Title"] = "Rezervasyonlarım";
    Layout = "_UserLayout";
}

<div class="container py-5">
    <h2 class="mb-2">Rezervasyonlarım</h2>
    <p class="text-muted mb-4">
        Tüm rezervasyonlarını burada takip edebilirsin.
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-white rounded-4 p-5 text-center">
            <i class="bi bi-calendar2-x fs-1 text-secondary"></i>
            <h5 class="mt-3">Henüz rezervasyonun yok.</h5>
            <p class="text-muted">
                Yeni bir seyahat keşfetmek için turlara göz atabilirsin.
            </p>
            <a asp-area=""
               asp-controller="Tour"
               asp-action="Index"
               class="btn-travelio">
                Turları Keşfet
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var reservation in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="row g-0">
                            <div class="col-md-4">
                                @if (!string.IsNullOrWhiteSpace(reservation.TourImageUrl))
                                {
                                    <img src="@reservation.TourImageUrl"
                                         alt="@reservation.TourName"
                                         class="w-100 h-100"
                                         style="min-height:220px; object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light h-100"
                                         style="min-height:220px;">
                                        <i class="bi bi-image fs-1 text-secondary"></i>
                                    </div>
                                }
                            </div>

                            <div class="col-md-8">
                                <div class="card-body p-4">
                                    <span class="text-muted small">
                                        @reservation.TourType
                                    </span>

                                    <h5 class="mt-2 mb-3">
                                        @reservation.TourName
                                    </h5>

                                    <p class="mb-2">
                                        <i class="bi bi-calendar-event me-2"></i>
                                        @reservation.StartDate.ToString("dd.MM.yyyy")
                                        – @reservation.EndDate.ToString("dd.MM.yyyy")
                                    </p>

                                    <p class="mb-2">
                                        <i class="bi bi-people me-2"></i>
                                        @reservation.Adult yetişkin,
                                        @reservation.Child çocuk
                                    </p>

                                    <p class="mb-2">
                                        <i class="bi bi-clock-history me-2"></i>
                                        Rezervasyon tarihi:
                                        @reservation.ReservationCreatedDate.ToString("dd.MM.yyyy")
                                    </p>

                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                                        <strong class="fs-5">
                                            @reservation.TotalPrice.ToString("N2") ₺
                                        </strong>

                                        <span class="badge bg-light text-dark border">
                                            @reservation.ReservationStatus
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
