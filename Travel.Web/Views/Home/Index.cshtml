</section>

<!-- CTA -->
<section id="iletisim">
    <div class="container">

        <div class="cta-wrap text-center">

            <div class="eyebrow" style="color:#7fe3e3">
                @Localizer["NextStopIsYou"]
            </div>

            <h2 class="mt-2">
                @Localizer["NextAdventureTitle"]
            </h2>

            <p>
                @Localizer["NextAdventureDescription"]
            </p>

            <div class="mt-4 d-flex gap-3 justify-content-center flex-wrap">

                <a href="#turlar" class="btn btn-teal">
                    @Localizer["DiscoverTours"]
                </a>

                <a href="#" class="btn-ghost">
                    @Localizer["ContactUs"]
                </a>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
    </script>
}
