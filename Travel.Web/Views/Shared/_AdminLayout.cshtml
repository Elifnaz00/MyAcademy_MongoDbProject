<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — Travelio Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet" />

    <style>
        :root {
            --navy: #0e2a3b;
            --navy-2: #12384c;
            --navy-3: #1b455c;
            --teal: #0fa3a3;
            --teal-dark: #0b7f80;
            --cream: #f7f5f0;
            --bg: #f4f5f4;
            --white: #fff;
            --ink: #0e2a3b;
            --muted: #6a7c88;
            --line: #e7e2d8;
            --line-2: #eef0ef;
            --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
            --shadow-md: 0 18px 50px rgba(14,42,59,.12);
            --sidebar-w: 266px;
            --r: 16px;
            --ok-bg: #e3f4f0;
            --ok-fg: #0b7f80;
            --wait-bg: #fbf1dc;
            --wait-fg: #a9741a;
            --cancel-bg: #f6e4e2;
            --cancel-fg: #b45a4f;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            color: var(--ink);
            background: var(--bg);
            margin: 0;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, .brand {
            font-family: 'Sora', sans-serif;
        }

        a {
            text-decoration: none;
        }

        /* SIDEBAR */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            background: var(--navy);
            display: flex;
            flex-direction: column;
            z-index: 1045;
        }

        .sb-brand {
            padding: 1.5rem 1.5rem 1.3rem;
            display: flex;
            align-items: center;
            gap: .65rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

            .sb-brand .dot {
                width: 11px;
                height: 11px;
                border-radius: 50%;
                background: var(--teal);
                box-shadow: 0 0 0 4px rgba(15,163,163,.22);
                flex: none;
            }

            .sb-brand .txt b {
                font-family: 'Sora';
                font-weight: 800;
                color: #fff;
                font-size: 1.25rem;
                letter-spacing: -.4px;
                display: block;
                line-height: 1;
            }

            .sb-brand .txt span {
                font-size: .7rem;
                color: #7fe3e3;
                letter-spacing: .16em;
                text-transform: uppercase;
                font-weight: 600;
            }

        .sb-menu {
            flex: 1;
            overflow-y: auto;
            padding: 1rem .8rem;
            display: flex;
            flex-direction: column;
            gap: .15rem;
        }

        .sb-cap {
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: rgba(255,255,255,.35);
            font-weight: 600;
            padding: .4rem .8rem .3rem;
        }

        .sb-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem .85rem;
            border-radius: 11px;
            color: rgba(255,255,255,.72);
            font-weight: 500;
            font-size: .92rem;
            transition: .18s;
            position: relative;
        }

            .sb-link svg {
                flex: none;
                opacity: .85;
            }

            .sb-link:hover {
                background: rgba(255,255,255,.07);
                color: #fff;
            }

            .sb-link.active {
                background: var(--teal);
                color: #fff;
                box-shadow: 0 8px 20px rgba(15,163,163,.28);
            }

                .sb-link.active svg {
                    opacity: 1;
                }

        .sb-badge {
            margin-left: auto;
            background: rgba(255,255,255,.16);
            color: #fff;
            font-size: .7rem;
            font-weight: 700;
            padding: .1rem .45rem;
            border-radius: 999px;
        }

        .sb-link.active .sb-badge {
            background: rgba(255,255,255,.25);
        }

        .sb-foot {
            padding: .8rem;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .sb-user {
            display: flex;
            align-items: center;
            gap: .7rem;
            padding: .6rem .7rem;
            border-radius: 12px;
            background: rgba(255,255,255,.05);
        }

            .sb-user .av {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: var(--teal);
                color: #fff;
                display: grid;
                place-items: center;
                font-family: 'Sora';
                font-weight: 700;
                font-size: .85rem;
                flex: none;
            }

            .sb-user b {
                display: block;
                color: #fff;
                font-size: .86rem;
                font-family: 'Sora';
                line-height: 1.2;
            }

            .sb-user span {
                font-size: .74rem;
                color: rgba(255,255,255,.55);
            }

        /* MAIN */

        .main {
            margin-left: var(--sidebar-w);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* TOPBAR */

        .topbar {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: rgba(244,245,244,.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--line);
            padding: .85rem 1.8rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .hamb {
            display: none;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 10px;
            width: 40px;
            height: 40px;
            place-items: center;
            color: var(--navy);
            cursor: pointer;
        }

        .topbar .tb-title {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--navy);
        }

        .tb-search {
            margin-left: .5rem;
            position: relative;
            flex: 1;
            max-width: 320px;
        }

            .tb-search svg {
                position: absolute;
                left: .8rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--muted);
            }

            .tb-search input {
                width: 100%;
                border: 1px solid var(--line);
                background: #fff;
                border-radius: 999px;
                padding: .55rem .9rem .55rem 2.3rem;
                font-size: .88rem;
                outline: none;
                color: var(--navy);
            }

                .tb-search input:focus {
                    border-color: var(--teal);
                    box-shadow: 0 0 0 3px rgba(15,163,163,.1);
                }

        .tb-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: .9rem;
        }

        .tb-icon {
            position: relative;
            width: 40px;
            height: 40px;
            border-radius: 11px;
            background: #fff;
            border: 1px solid var(--line);
            display: grid;
            place-items: center;
            color: var(--navy);
            cursor: pointer;
            transition: .2s;
        }

            .tb-icon:hover {
                border-color: var(--teal);
                color: var(--teal-dark);
            }

            .tb-icon .n-badge {
                position: absolute;
                top: -5px;
                right: -5px;
                background: #e0575b;
                color: #fff;
                font-size: .66rem;
                font-weight: 700;
                min-width: 17px;
                height: 17px;
                border-radius: 999px;
                display: grid;
                place-items: center;
                padding: 0 3px;
            }

        .tb-user {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding-left: .4rem;
        }

            .tb-user .av {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: var(--navy);
                color: #fff;
                display: grid;
                place-items: center;
                font-family: 'Sora';
                font-weight: 700;
                font-size: .82rem;
            }

            .tb-user .nm {
                line-height: 1.15;
            }

                .tb-user .nm b {
                    font-family: 'Sora';
                    font-size: .86rem;
                    color: var(--navy);
                    display: block;
                }

                .tb-user .nm span {
                    font-size: .74rem;
                    color: var(--muted);
                }

        /* COMMON CONTENT */

        .content {
            padding: 1.8rem;
            flex: 1;
        }

        /* FOOTER */

        .admin-foot {
            padding: 1.1rem 1.8rem;
            border-top: 1px solid var(--line);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: .82rem;
            color: var(--muted);
        }

        /* MOBILE SIDEBAR */

        .sb-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(14,42,59,.45);
            z-index: 1044;
        }

            .sb-overlay.show {
                display: block;
            }

        @@media(max - width:1100px) {
            .sidebar

        {
            transform: translateX(-100%);
            transition: transform .3s ease;
        }

        .sidebar.show {
            transform: none;
        }

        .main {
            margin-left: 0;
        }

        .hamb {
            display: grid;
        }

        }

        @@media(max - width:575px) {
            .content

        {
            padding: 1.1rem;
        }

        .tb-search {
            display: none;
        }

        .tb-user .nm {
            display: none;
        }

        .topbar {
            padding: .8rem 1rem;
        }

        }
    </style>
</head>

<body>

    @{
        var activeMenu = ViewData["ActiveMenu"]?.ToString();
        var pageTitle = ViewData["PageTitle"]?.ToString() ?? ViewData["Title"]?.ToString() ?? "Admin";
    }

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">

        <div class="sb-brand">
            <span class="dot"></span>
            <span class="txt">
                <b>Travelio</b>
                <span>Admin Panel</span>
            </span>
        </div>

        <nav class="sb-menu">

            <div class="sb-cap">Yönetim</div>

            <a class="sb-link @(activeMenu == "Dashboard" ? "active" : "")"
               href="/Admin/Dashboard/Index">

                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                </svg>

                Dashboard
            </a>

            <a class="sb-link @(activeMenu == "Tours" ? "active" : "")"
               href="/Admin/Tour/Index">

                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7h18v12H3z" />
                    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                </svg>

                Turlar
            </a>

            <a class="sb-link" href="/Admin/Reservation/Index" @(activeMenu == "Questions" ? "active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                </svg>

                Rezervasyonlar
                <span class="sb-badge">126</span>
            </a>

            <a class="sb-link" href="#" @(activeMenu == "Questions" ? "active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>

                Yorumlar
            </a>

            <a class="sb-link @(activeMenu == "Questions" ? "active" : "")"
               href="/Admin/Question/Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" />
                    <line x1="12" y1="17" x2="12" y2="17" />
                </svg>

                Sorular
                <span class="sb-badge">17</span>
            </a>

            <a class="sb-link" href="#" @(activeMenu == "Questions" ? "active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>

                Kullanıcılar
            </a>

            <div class="sb-cap">Katalog</div>

            <a class="sb-link" href="#" @(activeMenu == "Questions" ? "active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                    <line x1="7" y1="7" x2="7" y2="7" />
                </svg>

                Kategoriler
            </a>

            <a class="sb-link" href="#" @(activeMenu == "Questions" ? "active" : "")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>

                Destinasyonlar
            </a>

            <div class="sb-cap">Diğer</div>

            <a class="sb-link" href="index.html">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12l9-9 9 9" />
                    <path d="M9 21V9h6v12" />
                </svg>

                Siteye Dön
            </a>

            <a class="sb-link" href="/Auth/Logout" >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>

                Çıkış Yap
            </a>

        </nav>

        <div class="sb-foot">
            <div class="sb-user">
                <div class="av">MY</div>
                <div>
                    @if(User.Identity.IsAuthenticated)
                    {
                        <b>@User.Identity.Name</b>
                        <span>Yönetici</span>
                    }
                   
                </div>
            </div>
        </div>

    </aside>

    <div class="sb-overlay" id="sbOverlay" onclick="toggleSidebar(false)"></div>

    <!-- MAIN -->
    <div class="main">

        <!-- TOPBAR -->
        <header class="topbar">

            <button class="hamb"
                    onclick="toggleSidebar(true)"
                    aria-label="Menü">

                <svg width="20" height="20" viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round">

                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />

                </svg>

            </button>

            <span class="tb-title">@pageTitle</span>

            <div class="tb-search">

                <svg width="16" height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />

                </svg>

                <input type="text"
                       placeholder="Ara: rezervasyon, tur, kullanıcı..." />

            </div>

            <div class="tb-right">

                <button class="tb-icon" aria-label="Bildirimler">

                    <svg width="18" height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />

                    </svg>

                    <span class="n-badge">3</span>

                </button>

                <div class="tb-user">

                    <div class="av">MY</div>

                    <div class="nm">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <b>@User.Identity.Name</b>
                            <span>Yönetici</span>
                        }
                    </div>

                </div>

            </div>

        </header>

        @RenderBody()

        <footer class="admin-foot">
            <span>© 2026 Travelio Admin Panel</span>
            <span>v1.0</span>
        </footer>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleSidebar(show) {
            document.getElementById("sidebar").classList.toggle("show", show);
            document.getElementById("sbOverlay").classList.toggle("show", show);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>