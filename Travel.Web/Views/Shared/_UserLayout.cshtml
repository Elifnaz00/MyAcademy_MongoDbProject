@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer
@using System.Security.Claims

@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var pageLanguage = currentCulture.StartsWith("en") ? "en" : "tr";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@pageLanguage">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Travelio</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet" />

    <style>
        :root {
            --navy: #0e2a3b;
            --navy-2: #12384c;
            --teal: #0fa3a3;
            --teal-dark: #0b7f80;
            --cream: #f7f5f0;
            --white: #ffffff;
            --ink: #0e2a3b;
            --muted: #5d7180;
            --line: #e7e2d8;
            --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
            --shadow-md: 0 18px 50px rgba(14,42,59,.12);
            --r: 18px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            color: var(--ink);
            background: var(--cream);
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, .brand, .display-font {
            font-family: 'Sora', sans-serif;
        }

        .eyebrow {
            font-family: 'Sora', sans-serif;
            text-transform: uppercase;
            letter-spacing: .22em;
            font-size: .72rem;
            font-weight: 700;
            color: var(--teal-dark);
        }

        a {
            text-decoration: none;
        }

        .btn-teal {
            background: var(--teal);
            color: #fff;
            border: none;
            border-radius: 999px;
            font-weight: 600;
            padding: .8rem 1.6rem;
            transition: .25s;
        }

            .btn-teal:hover {
                background: var(--teal-dark);
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 12px 26px rgba(15,163,163,.32);
            }

        .btn-ghost {
            background: transparent;
            border: 1.5px solid rgba(255,255,255,.5);
            color: #fff;
            border-radius: 999px;
            font-weight: 600;
            padding: .7rem 1.4rem;
            transition: .25s;
        }


            .btn-ghost:hover {
                background: #fff;
                color: var(--navy);
            }

        .navbar {
            background: rgba(247,245,240,.85);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line);
            padding: .9rem 0;
        }

        .brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--navy);
            letter-spacing: -.5px;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

            .brand .dot {
                width: 11px;
                height: 11px;
                border-radius: 50%;
                background: var(--teal);
                display: inline-block;
                box-shadow: 0 0 0 4px rgba(15,163,163,.18);
            }

        .navbar .nav-link {
            color: var(--navy);
            font-weight: 500;
            margin: 0 .35rem;
            position: relative;
        }

            .navbar .nav-link:hover,
            .navbar .nav-link.active {
                color: var(--teal-dark);
            }

                .navbar .nav-link.active::after {
                    content: "";
                    position: absolute;
                    left: .7rem;
                    right: .7rem;
                    bottom: -2px;
                    height: 2px;
                    background: var(--teal);
                    border-radius: 2px;
                }

        .profile-pill {
            display: flex;
            align-items: center;
            gap: .55rem;
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 999px;
            padding: .35rem .35rem .35rem .95rem;
            font-weight: 600;
            color: var(--navy);
            transition: .2s;
        }

            .profile-pill:hover {
                box-shadow: var(--shadow-sm);
                color: var(--navy);
            }

            .profile-pill .avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: var(--navy);
                color: #fff;
                display: grid;
                place-items: center;
                font-size: .85rem;
                font-weight: 700;
            }

        .language-switch {
            display: flex;
            align-items: center;
            gap: .25rem;
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 999px;
            padding: .3rem;
            margin-left: .75rem;
        }

            .language-switch a {
                display: inline-block;
                padding: .4rem .6rem;
                border-radius: 999px;
                font-size: .8rem;
                font-weight: 700;
                color: var(--navy);
            }

                .language-switch a.selected {
                    background: var(--teal);
                    color: #fff;
                }

        footer {
            background: var(--navy);
            color: rgba(255,255,255,.72);
            padding: 4rem 0 2rem;
        }

            footer .brand {
                color: #fff;
            }

            footer h6 {
                color: #fff;
                font-family: 'Sora';
                font-weight: 600;
                letter-spacing: .02em;
                margin-bottom: 1rem;
            }

            footer a {
                color: rgba(255,255,255,.72);
                display: block;
                margin-bottom: .55rem;
                font-size: .92rem;
            }

                footer a:hover {
                    color: #7fe3e3;
                }

        .foot-social a {
            display: inline-grid;
            place-items: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            margin-right: .5rem;
        }

            .foot-social a:hover {
                background: var(--teal);
            }

        .foot-bottom {
            border-top: 1px solid rgba(255,255,255,.12);
            margin-top: 2.5rem;
            padding-top: 1.5rem;
            font-size: .85rem;
        }

        @@media (max-width: 991px) {
            .language-switch {
                margin: 1rem 0 0;
                width: fit-content;
            }

            .profile-pill {
                margin-top: 1rem;
                width: fit-content;
            }
        }

       
        .account-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1.25rem;
        }

        .account-title-icon {
            display: inline-grid;
            place-items: center;
            width: 30px;
            height: 30px;
            border-radius: 10px;
            background: rgba(15, 163, 163, .16);
            color: #7fe3e3;
            font-size: 1rem;
        }

        .account-links {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            max-width: 540px;
        }

        .account-link {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 48px;
            padding: 10px 12px;
            margin: 0;
            border: 1px solid rgba(255, 255, 255, .10);
            border-radius: 12px;
            background: rgba(255, 255, 255, .04);
            color: rgba(255, 255, 255, .78);
            font-size: .88rem;
            transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease;
        }

            .account-link:hover {
                background: rgba(15, 163, 163, .12);
                border-color: rgba(15, 163, 163, .45);
                color: #7fe3e3;
                transform: translateY(-2px);
            }

        .account-link-icon {
            display: inline-grid;
            place-items: center;
            flex: 0 0 28px;
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: rgba(255, 255, 255, .08);
            color: #7fe3e3;
            font-size: 1.05rem;
        }

        @@media (max-width: 575px) {
            .account-links

        {
            grid-template-columns: 1fr;
        }

        }

       
       
        .navbar .navbar-nav {
            gap: 2px;
        }

        .navbar .nav-link {
            white-space: nowrap;
            font-size: .82rem;
            padding: .65rem .45rem;
        }

        .navbar .language-switch {
            flex-shrink: 0;
            margin-left: .75rem;
        }

        /* Responsive navbar */
        @@media (max-width: 1199.98px) {
            .navbar .navbar-nav

        {
            align-items: flex-start !important;
            padding-top: 1rem;
        }

        .navbar .nav-link {
            padding: .65rem .25rem;
        }

        .navbar .language-switch {
            margin: .75rem 0 1rem;
        }

        }
      
       
    </style>
</head>

<body>
   
    <nav class="navbar navbar-expand-xl sticky-top">
        <div class="container">

            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="dot"></span>
                Travelio
            </a>

            <button class="navbar-toggler border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#nav"
                    aria-controls="nav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="nav">

                <ul class="navbar-nav mx-auto align-items-xl-center">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            @Localizer["Home"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Tour"
                           asp-action="Index">
                            @Localizer["Tours"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="destinasyonlar">
                            @Localizer["Destinations"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="yorumlar">
                            @Localizer["Reviews"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="hakkimizda">
                            @Localizer["AboutUs"]
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="iletisim">
                            @Localizer["Contact"]
                        </a>
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reservation"
                               asp-action="Index">
                                @Localizer["MyReservations"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="FavoriteTours"
                               asp-action="Index">
                                @Localizer["MyFavoriteTours"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Comments"
                               asp-action="MyComments">
                                @Localizer["MyComments"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Questions"
                               asp-action="MyQuestions">
                                @Localizer["MyQuestions"]
                            </a>
                        </li>
                    }

                </ul>

                <div class="language-switch">
                    <a asp-controller="Language"
                       asp-action="SetLanguage"
                       asp-route-culture="tr-TR"
                       asp-route-returnUrl="@returnUrl"
                       class="@(currentCulture.StartsWith("tr") ? "selected" : "")">
                        TR
                    </a>

                    <a asp-controller="Language"
                       asp-action="SetLanguage"
                       asp-route-culture="en-US"
                       asp-route-returnUrl="@returnUrl"
                       class="@(currentCulture.StartsWith("en") ? "selected" : "")">
                        EN
                    </a>
                </div>

            </div>
        </div>
    </nav>
  
    @RenderBody()

    <footer>
        <div class="container">
            <div class="row g-4">

                <div class="col-lg-4">
                    <a class="brand mb-3"
                       asp-controller="Home"
                       asp-action="Index">
                        <span class="dot"></span>
                        Travelio
                    </a>

                    <p style="max-width:34ch">
                        @Localizer["FooterDescription"]
                    </p>

                    <div class="foot-social mt-3">
                        <a href="#" aria-label="Instagram">
                            <svg width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="2" width="20" height="20" rx="5" />
                                <circle cx="12" cy="12" r="4" />
                                <circle cx="17.5" cy="6.5" r="1" />
                            </svg>
                        </a>

                        <a href="#" aria-label="Twitter">
                            <svg width="18" height="18" viewBox="0 0 24 24"
                                 fill="currentColor">
                                <path d="M22 4.01c-1 .49-1.98.689-3 .99-1.121-1.265-2.783-1.335-4.38-.737S11.977 6.323 12 8v1c-3.245.083-6.135-1.395-8-4 0 0-4.182 7.433 4 11-1.872 1.247-3.739 2.088-6 2 3.308 1.803 6.913 2.423 10.034 1.517 3.58-1.04 6.522-3.723 7.651-7.742a13.84 13.84 0 0 0 .497-3.753c-.002-.249 1.51-2.772 1.818-4.013z" />
                            </svg>
                        </a>

                        <a href="#" aria-label="Facebook">
                            <svg width="18" height="18" viewBox="0 0 24 24"
                                 fill="currentColor">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                            </svg>
                        </a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h6>@Localizer["Explore"]</h6>

                    <a asp-controller="Tours" asp-action="Index">
                        @Localizer["Tours"]
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="destinasyonlar">
                        @Localizer["Destinations"]
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="yorumlar">
                        @Localizer["Reviews"]
                    </a>

                    <a href="#">
                        @Localizer["Campaigns"]
                    </a>
                </div>

                <div class="col-6 col-lg-2">
                    <h6>@Localizer["Corporate"]</h6>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="hakkimizda">
                        @Localizer["AboutUs"]
                    </a>

                    <a href="#">
                        @Localizer["Careers"]
                    </a>

                    <a href="#">
                        @Localizer["Blog"]
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="iletisim">
                        @Localizer["Contact"]
                    </a>
                </div>

                <div class="col-lg-4">
                    <h6>@Localizer["Join"]</h6>

                    <p style="max-width:36ch">
                        @Localizer["JoinNewsletter"]
                    </p>

                    <div class="d-flex gap-2 mt-2" style="max-width:360px">
                        <input class="form-control"
                               style="border-radius:999px"
                               placeholder="@Localizer["EmailAddress"]" />

                        <button class="btn-teal" style="white-space:nowrap">
                            @Localizer["Join"]
                        </button>
                    </div>
                </div>

            </div>

            <div class="foot-bottom d-flex flex-wrap justify-content-between gap-2">
                <span>
                    © 2026 Travelio. @Localizer["AllRightsReserved"]
                </span>

                <span>
                    @Localizer["Privacy"] ·
                    @Localizer["Terms"] ·
                    @Localizer["Cookies"]
                </span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
