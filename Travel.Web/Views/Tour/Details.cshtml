                <div class="meet-note">
                    <b>@Localizer["MeetingPoint"]</b>
                    <p>@Localizer["MeetingPointDescription"]</p>
                </div>
            </div>

            <div class="content-block">
                <h2>@Localizer["GuestReviews"]</h2>

                <div class="rev-summary mb-3">
                    <div class="rev-score">
                        <div class="num">4.8</div>
                        <div class="stars">★★★★★</div>
                        <div class="cnt">1.687 @Localizer["Reviews"]</div>
                    </div>

                    <div class="rev-bars">
                        <div class="bar-row">
                            <span class="lab">5 @Localizer["Stars"]</span>
                            <div class="bar-track"><div class="bar-fill" style="width:82%"></div></div>
                            <span class="pct">%82</span>
                        </div>
                        <div class="bar-row">
                            <span class="lab">4 @Localizer["Stars"]</span>
                            <div class="bar-track"><div class="bar-fill" style="width:13%"></div></div>
                            <span class="pct">%13</span>
                        </div>
                        <div class="bar-row">
                            <span class="lab">3 @Localizer["Stars"]</span>
                            <div class="bar-track"><div class="bar-fill" style="width:4%"></div></div>
                            <span class="pct">%4</span>
                        </div>
                        <div class="bar-row">
                            <span class="lab">2 @Localizer["Stars"]</span>
                            <div class="bar-track"><div class="bar-fill" style="width:1%"></div></div>
                            <span class="pct">%1</span>
                        </div>
                        <div class="bar-row">
                            <span class="lab">1 @Localizer["Stars"]</span>
