                            </div>
                            <span class="rev-stars">★★★★★</span>
                        </div>
                        <p>@item.CommentContent</p>
                    </div>
                }

                <div class="write-box">
                    <div>
                        <b>@Localizer["JoinedTour"]</b>
                        <p>@Localizer["ShareExperience"]</p>
                    </div>
                    <button class="btn-teal" type="button" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        @Localizer["WriteReview"]
                    </button>
                </div>
            </div>




            <div class="content-block">
                <h2>@Localizer["TourQuestions"]</h2>




                <div class="content-block">
                    <h2>@Localizer["TourQuestions"]</h2>

                    @if (Model.Questions != null && Model.Questions.Any())
                    {
                        @foreach (var question in Model.Questions)
                        {
                            <div class="qa-item">
                                <div class="qa-q">
                                    <span class="qa-avatar">
                                        @(string.IsNullOrWhiteSpace(question.UserName)
                                                                        ? "U"
                                                                        : question.UserName.Substring(0, 1).ToUpper())
                            </span>

                                    <div>
                                        <div class="who">
                                            @question.UserName
                                        </div>

                                        <div class="txt">
                                            @question.QuestionContent
                                        </div>
                                    </div>
                                </div>

                        @if (question.IsReply)
                                {
                                    <div class="qa-a">
                                        <span class="brand-mini">Travelio</span>

                                        <span class="txt">
                                            @question.AnsweredText
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="txt">@Localizer["NoQuestionsYet"]</p>
                    }

                    <div class="ask-box">
                        <form asp-action="CreateQuestion" asp-controller="Tour" method="post">
                            <div class="book-label" style="margin-top:0">
                                @Localizer["QuestionPrompt"]
                            </div>

                            <input type="hidden" name="TourId" value="@Model.Tour.Id" />

                            <textarea id="askInput"
                                      name="QuestionContent"
                                      placeholder="@Localizer["QuestionPlaceholder"]"
                                      required></textarea>

                            <button class="btn-teal mt-3" type="submit">
                                @Localizer["SendQuestion"]
                            </button>

                            <div id="askOk"
                                 style="display:none;color:var(--teal-dark);font-weight:600;font-size:.9rem;margin-top:.8rem">
                                @Localizer["QuestionReceived"]
                            </div>
                        </form>
                    </div>
                </div>

            </div>

        </div>

        <div class="col-lg-4">
            <div class="book-sticky">
                <div class="book-card">
                    <div class="price-top">
                        <small>@Localizer["PerPerson"]</small>
                        <div class="big" id="unitPrice">
                            @Model.Tour.Price.ToString("N0") <span>TL</span>
                        </div>
                        <div class="price-note">@Localizer["PriceIncludesTaxes"]</div>
                    </div>

                    <div class="book-label">@Localizer["TourDate"]</div>

                    <div id="dateOptions">
                        @foreach (var item in Model.Tour.TourDates)
                        {
                            <label class="date-opt"
                                   data-start-date="@item.StartDate.ToString("yyyy-MM-dd")"
                                   data-end-date="@item.EndDate.ToString("yyyy-MM-dd")">
                                <span class="d">
                                    @item.StartDate.ToString("dd MMM yyyy") -
                                    @item.EndDate.ToString("dd MMM yyyy")
                                </span>
                                <input type="radio" name="tourDate" />
                                <span class="left">@string.Format(Localizer["LastQuota"].Value, item.Quota)</span>
                            </label>
                        }
                    </div>

                    <div class="book-label">@Localizer["NumberOfPeople"]</div>

                    <div class="counter-row">
                        <div class="cl">
                            <b>@Localizer["Adults"]</b>
                            <span>@Localizer["AdultAge"]</span>
                        </div>
                        <div class="counter">
                            <button type="button" onclick="changeCount('adult',-1)" id="adultMinus">−</button>
                            <span class="val" id="adultVal">2</span>
                            <button type="button" onclick="changeCount('adult',1)">+</button>
                        </div>
                    </div>

                    <div class="counter-row">
                        <div class="cl">
                            <b>@Localizer["Children"]</b>
                            <span>@Localizer["ChildAge"]</span>
                        </div>
                        <div class="counter">
                            <button type="button" onclick="changeCount('child',-1)" id="childMinus">−</button>
                            <span class="val" id="childVal">0</span>
                            <button type="button" onclick="changeCount('child',1)">+</button>
                        </div>
                    </div>

                    <div class="summary">
                        <div class="row-line">
                            <span id="adultLine"></span>
                            <b id="adultSum"></b>
                        </div>

                        <div class="row-line" id="childRow" style="display:none">
                            <span id="childLine"></span>
                            <b id="childSum"></b>
                        </div>

                        <div class="row-line">
                            <span>@Localizer["Subtotal"]</span>
                            <b id="subtotal"></b>
                        </div>

                        <div class="total">
                            <span>@Localizer["Total"]</span>
                            <b id="grandTotal"></b>
                        </div>
                    </div>

                    <button class="btn-teal" type="button" onclick="reserve()">
                        @Localizer["BookNow"]
                    </button>

                    <div class="trust">
                        <span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                            @Localizer["SecureBooking"]
                        </span>
                        <span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            @Localizer["FreePreBooking"]
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h2 style="font-family:'Sora';font-weight:700;font-size:1.6rem;color:var(--navy);margin-bottom:1.4rem">
            @Localizer["SimilarTours"]
        </h2>
        <div class="row g-4" id="similarGrid"></div>
    </div>
</div>

<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Tour" asp-action="CreateComment" method="post">
                <div class="modal-header border-0">
                    <h5 class="modal-title" style="font-family:'Sora';font-weight:700;color:var(--navy)">
                        @Localizer["ShareYourExperience"]
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="TourId" value="@Model.Tour.Id" />

                    <div class="book-label" style="margin-top:0">@Localizer["YourRating"]</div>
                    <div id="starPicker" class="mb-3">
                        <span class="star-pick" data-v="1">★</span>
                        <span class="star-pick" data-v="2">★</span>
                        <span class="star-pick" data-v="3">★</span>
                        <span class="star-pick" data-v="4">★</span>
                        <span class="star-pick" data-v="5">★</span>
                    </div>

                    <input type="hidden" id="commentRating" name="CommentRating" value="0" />

                    <div class="book-label" style="margin-top:0">@Localizer["YourComment"]</div>
                    <textarea id="reviewText"
                              name="CommentContent"
                              class="form-control"
                              style="border-radius:14px;border-color:var(--line);min-height:110px"
                              placeholder="@Localizer["ReviewPlaceholder"]"></textarea>
                </div>

                <div class="modal-footer border-0">
                    <button type="submit" class="btn-teal">
                        @Localizer["SubmitComment"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const UI = {
            day: @Html.Raw(JsonSerializer.Serialize(Localizer["Day"].Value)),
            days: @Html.Raw(JsonSerializer.Serialize(Localizer["Days"].Value)),
            nights: @Html.Raw(JsonSerializer.Serialize(Localizer["Nights"].Value)),
            adults: @Html.Raw(JsonSerializer.Serialize(Localizer["Adults"].Value)),
            children: @Html.Raw(JsonSerializer.Serialize(Localizer["Children"].Value)),
            selectDate: @Html.Raw(JsonSerializer.Serialize(Localizer["SelectDate"].Value)),
            bookingSuccess: @Html.Raw(JsonSerializer.Serialize(Localizer["BookingSuccess"].Value)),
            bookingError: @Html.Raw(JsonSerializer.Serialize(Localizer["BookingError"].Value)),
            shareDemo: @Html.Raw(JsonSerializer.Serialize(Localizer["ShareDemo"].Value)),
            popular: @Html.Raw(JsonSerializer.Serialize(Localizer["Popular"].Value)),
            viewTour: @Html.Raw(JsonSerializer.Serialize(Localizer["ViewTour"].Value)),
            perPerson: @Html.Raw(JsonSerializer.Serialize(Localizer["PerPerson"].Value))
        };

        const ITIN = @Html.Raw(JsonSerializer.Serialize(Model.Tour.Itineraries));

        const itinEl = document.getElementById("itinerary");

        itinEl.innerHTML = (ITIN || []).map((d, i) => `
            <div class="itin-item ${i === 0 ? 'open' : ''}">
                <div class="itin-head" onclick="toggleDay(this)">
                    <span class="day-tag">${d.Day}. ${UI.day}</span>
                    <span class="itin-title">${d.DayTitle ?? ""}</span>
                    <span class="itin-toggle">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </span>
                </div>

                <div class="itin-body">
                    <div class="itin-inner">
                        <p style="margin-bottom:.4rem">${d.ProgramDescription ?? ""}</p>
                        <div class="itin-tags">
                            <span>🏨 ${d.Accomodation ?? ""}</span>
                            <span>🚌 ${d.TransportType ?? ""}</span>
                            <span>🍽️ ${d.Meal ?? ""}</span>
                        </div>
                    </div>
                </div>
            </div>
        `).join("");

        const firstItem = itinEl.querySelector(".itin-item.open");
        if (firstItem) {
            const firstBody = firstItem.querySelector(".itin-body");
            firstBody.style.maxHeight = firstBody.scrollHeight + "px";
        }

        function toggleDay(head) {
            const item = head.parentElement;
            const body = item.querySelector(".itin-body");
            const isOpen = item.classList.contains("open");

            if (isOpen) {
                item.classList.remove("open");
                body.style.maxHeight = "0";
            } else {
                item.classList.add("open");
                body.style.maxHeight = body.scrollHeight + "px";
            }
        }

        const UNIT = Number(@Html.Raw(JsonSerializer.Serialize(Model.Tour.Price)));
        let adult = 2;
        let child = 0;

        const childPrice = () => Math.round(UNIT * 0.5);

        function fmt(n) {
            return n.toLocaleString(document.documentElement.lang || "tr-TR") + " TL";
        }

        function changeCount(type, delta) {
            if (type === "adult") {
                adult = Math.max(1, adult + delta);
            } else {
                child = Math.max(0, child + delta);
            }
            updateSummary();
        }

        function updateSummary() {
            document.getElementById("adultVal").textContent = adult;
            document.getElementById("childVal").textContent = child;
            document.getElementById("adultMinus").disabled = adult <= 1;
            document.getElementById("childMinus").disabled = child <= 0;

            const adultSum = adult * UNIT;
            const childSum = child * childPrice();
            const sub = adultSum + childSum;

            document.getElementById("adultLine").textContent =
                adult + " " + UI.adults + " (" + fmt(UNIT) + ")";
            document.getElementById("adultSum").textContent = fmt(adultSum);

            const childRow = document.getElementById("childRow");

            if (child > 0) {
                childRow.style.display = "flex";
                document.getElementById("childLine").textContent =
                    child + " " + UI.children + " (" + fmt(childPrice()) + ")";
                document.getElementById("childSum").textContent = fmt(childSum);
            } else {
                childRow.style.display = "none";
            }

            document.getElementById("subtotal").textContent = fmt(sub);
            document.getElementById("grandTotal").textContent = fmt(sub);
        }

        updateSummary();

        document.querySelectorAll(".date-opt").forEach(opt => {
            opt.addEventListener("click", () => {
                document.querySelectorAll(".date-opt").forEach(o => o.classList.remove("sel"));
                opt.classList.add("sel");
                opt.querySelector("input").checked = true;
            });
        });

        function reserve() {
            const selectedDate = document.querySelector('input[name="tourDate"]:checked');

            if (!selectedDate) {
                alert(UI.selectDate);
                return;
            }

            const dateOption = selectedDate.closest(".date-opt");

            const data = {
                tourId: @Html.Raw(JsonSerializer.Serialize(Model.Tour.Id)),
                startDate: dateOption.dataset.startDate,
                endDate: dateOption.dataset.endDate,
                adult: adult,
                child: child
            };

            $.ajax({
                url: "/Reservation/Create",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function () {
                    alert(UI.bookingSuccess);
                },
                error: function (xhr) {
                    alert(xhr.responseJSON?.message || UI.bookingError);
                }
            });
        }

        function sharePage() {
            if (navigator.share) {
                navigator.share({
                    title: document.title,
                    url: location.href
                }).catch(() => {});
            } else if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(location.href)
                    .then(() => alert(UI.shareDemo))
                    .catch(() => alert(location.href));
            } else {
                alert(location.href);
            }
        }

        let pickedStars = 0;

        document.querySelectorAll(".star-pick").forEach(s => {
            s.addEventListener("click", () => {
                pickedStars = Number(s.dataset.v);
                document.getElementById("commentRating").value = pickedStars;

                document.querySelectorAll(".star-pick").forEach(x => {
                    x.classList.toggle("on", Number(x.dataset.v) <= pickedStars);
                });
            });
        });

        const SIMILAR = [
            {
                title: "Amalfi & Napoli",
                country: "İtalya",
                dur: "6 Gün / 5 Gece",
                rating: 4.9,
                reviews: 886,
                price: "49.500",
                badge: true,
                img: "https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=800&q=80"
            },
            {
                title: "Paris & Alsace",
                country: "Fransa",
                dur: "7 Gün / 6 Gece",
                rating: 4.8,
                reviews: 721,
                price: "47.900",
                badge: false,
                img: "https://images.unsplash.com/photo-1499856871958-5b9627545d1a?auto=format&fit=crop&w=800&q=80"
            },
            {
                title: "Prag & Viyana Kültür Turu",
                country: "Çekya · Avusturya",
                dur: "6 Gün / 5 Gece",
                rating: 4.8,
                reviews: 1421,
                price: "36.400",
                badge: false,
                img: "https://images.unsplash.com/photo-1541849546-216549ae216d?auto=format&fit=crop&w=800&q=80"
            }
        ];

        document.getElementById("similarGrid").innerHTML = SIMILAR.map(t => `
            <div class="col-md-6 col-lg-4">
                <article class="tour-card">
                    <div class="tour-media">
                        <img src="${t.img}" alt="${t.title}" loading="lazy" />
                        ${t.badge ? `<span class="tour-badge">${UI.popular}</span>` : ""}
                    </div>

                    <div class="tour-body">
                        <div class="tour-country">${t.country}</div>
                        <h3 class="tour-title">${t.title}</h3>

                        <div class="tour-meta">
                            <span>🗓️ ${t.dur}</span>
                            <span>
                                <span class="star">★</span> ${t.rating.toFixed(1)}
                                <span style="color:var(--muted)">(${t.reviews.toLocaleString()})</span>
                            </span>
                        </div>

                        <div class="tour-foot">
                            <div class="price">
                                <small>${UI.perPerson}</small>
                                <b>${t.price} <span>TL</span></b>
                            </div>
                            <a href="/Tour/Index" class="btn-incele">${UI.viewTour}</a>
                        </div>
                    </div>
                </article>
            </div>
        `).join("");
    </script>
}