<div class="container body-section">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="content-block">
                <h2>@Localizer["AboutTour"]</h2>
                <p>@Model.Tour.Description</p>
                <p>@Model.Tour.ShortImportantDescription</p>
            </div>

            <div class="content-block">
                <h2>@Localizer["TourHighlights"]</h2>
                <ul class="hl-list">
                    @foreach (var item in Model.Tour.Features)
                    {
                        <li>
                            <span class="hl-ico">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                            </span>
                            @item
                        </li>
                    }
                </ul>
            </div>

            <div class="content-block">
                <h2>@Localizer["DailyItinerary"]</h2>
                <div id="itinerary"></div>
            </div>

            <div class="content-block">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h2>@Localizer["Included"]</h2>
                        <ul class="inc-list">
                            @foreach (var item in Model.Tour.PriceIncludes)
                            {
                                <li><span class="inc-yes">✓</span>@item</li>
                            }
