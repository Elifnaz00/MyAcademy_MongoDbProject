            </div>

            <div class="content-block">
                <h2>@Localizer["TourInformation"]</h2>

                <div class="info-grid">
                    <div class="info-cell">
                        <div class="k">@Localizer["TourDuration"]</div>
                        <div class="v">@Model.Tour.DayTimeDuration @Localizer["Days"] / @Model.Tour.NightTimeDuration @Localizer["Nights"]</div>
                    </div>
                    <div class="info-cell">
                        <div class="k">@Localizer["StartingCity"]</div>
                        <div class="v">@Model.Tour.StartingCity</div>
                    </div>
                    <div class="info-cell">
                        <div class="k">@Localizer["Transportation"]</div>
                        <div class="v">@Model.Tour.TransportType</div>
                    </div>
                    <div class="info-cell">
                        <div class="k">@Localizer["Accommodation"]</div>
                        <div class="v">@Model.Tour.Accomodation</div>
                    </div>
                    <div class="info-cell">
                        <div class="k">@Localizer["GuideLanguage"]</div>
                        <div class="v">@Model.Tour.GuideLanguage</div>
                    </div>
                    <div class="info-cell">
                        <div class="k">@Localizer["GroupSize"]</div>
                        <div class="v">@Model.Tour.MaxQuota</div>
                    </div>
                    <div class="info-cell">
                        <div class="k">@Localizer["Visa"]</div>
