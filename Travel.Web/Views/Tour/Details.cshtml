                    </div>

                    <div class="col-md-6">
                        <h2>@Localizer["NotIncluded"]</h2>
                        <ul class="inc-list">
                            @foreach (var item in Model.Tour.NotPriceIncludes)
                            {
                                <li><span class="inc-no">✕</span>@item</li>
                            }
